# ============================================================
# OptimalSystemAgent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# PRODUCTION WARNING:
#   Before exposing OSA on any network interface, you MUST:
#     1. Set OSA_REQUIRE_AUTH=true
#     2. Set OSA_SHARED_SECRET to a strong random value
#        (generate with: openssl rand -hex 32)
#   Running without these settings on a network-accessible
#   port allows unauthenticated access to the full agent API.
# ============================================================

# LLM Providers
OSA_DEFAULT_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Ollama Cloud — set OLLAMA_API_KEY to use Ollama Cloud instead of local Ollama
# Leave OLLAMA_URL/OLLAMA_MODEL unset to use the defaults from config.exs (Ollama Cloud + nemotron-3-super:cloud)
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=nemotron-3-super:cloud
OLLAMA_API_KEY=

# HTTP Port
# Default: 8089 for standalone CLI/iex usage.
# Set to 9089 when running the Tauri desktop app — the app's Rust sidecar
# layer probes http://127.0.0.1:9089/health and reports "backend-unavailable"
# if nothing answers on that port.
OSA_HTTP_PORT=9089

# Channels
TELEGRAM_BOT_TOKEN=
# Required when Telegram is configured to send updates via webhook (not polling).
# Generate a strong random string: openssl rand -hex 32
# Set the same value when calling setWebhook: ?secret_token=<value>
# Without this, the webhook endpoint will refuse all requests with 503.
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Web Search
BRAVE_API_KEY=

# ============================================================
# SECURITY CONFIGURATION (Review before production deployment)
# ============================================================

# Authentication — REQUIRED for non-localhost deployments
# Set to 'true' to require authentication on all API endpoints
OSA_REQUIRE_AUTH=true

# Shared secret for JWT signing and HMAC integrity verification
# Generate with: openssl rand -hex 32
# REQUIRED when OSA_REQUIRE_AUTH=true — startup will fail if this is unset
# while OSA_REQUIRE_AUTH=true.
# Also used as the Bearer token value for direct API calls:
#   Authorization: Bearer <OSA_SHARED_SECRET>
OSA_SHARED_SECRET=

# JWT secret for token signing (falls back to OSA_SHARED_SECRET if not set)
# Without this, tokens are signed with an ephemeral secret and invalidated on restart.
# Set this explicitly when sharing JWT signing keys with a Go sidecar or
# external service. Resolution order: JWT_SECRET → OSA_SHARED_SECRET → ephemeral.
JWT_SECRET=

# ============================================================
# CHANNEL SECURITY
# ============================================================

# Telegram webhook signature verification secret
# Required when using Telegram webhook mode (not polling).
# Get from Telegram BotFather or generate your own: openssl rand -hex 32
# Set the same value when registering the webhook URL with Telegram.
# Note: already listed above in Channels; kept here for documentation clarity.
# TELEGRAM_WEBHOOK_SECRET= (see Channels section above)

# Slack signing secret for webhook verification
# Get from your Slack App dashboard: Basic Information > Signing Secret
# Used to verify that incoming Slack webhook payloads are genuine.
SLACK_SIGNING_SECRET=

# Discord webhook token
# Used when OSA sends outbound messages via a Discord webhook URL
# (distinct from the inbound DISCORD_BOT_TOKEN used for the bot gateway).
DISCORD_WEBHOOK_TOKEN=

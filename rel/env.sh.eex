#!/bin/sh

# OSA release environment — runs before every release command.
# Creates ~/.osa/ on first run, disables Erlang distribution (standalone binary).

export OSA_HOME="${OSA_HOME:-$HOME/.osa}"
export RELEASE_DISTRIBUTION=none
export RELEASE_COOKIE=osa_standalone

# ── BEAM scheduler busy-wait: off (issue #66) ─────────────────────
# The BEAM's schedulers, dirty-CPU schedulers and dirty-IO schedulers spin for
# a while looking for work before they park. That default is tuned for a
# latency-critical server on dedicated hardware. OSA is the opposite: a warm
# background daemon on someone's laptop that spends nearly all of its
# wall-clock waiting on a model to answer. There, the spin buys a few
# microseconds of dispatch latency nobody can perceive and costs real cores,
# real battery and real fan noise for as long as OSA is installed — up to one
# busy core per scheduler thread, which is where the 850% in issue #66 came
# from on a 10-core Mac.
#
# Set OSA_BEAM_BUSY_WAIT=1 to keep the stock OTP behaviour. Any ERL_FLAGS the
# user already exported are preserved and win, because ERL_FLAGS is applied
# left to right and ours are appended last only when the user set none of them.
if [ -z "${OSA_BEAM_BUSY_WAIT:-}" ]; then
  case "${ERL_FLAGS:-}" in
    *+sbwt*) ;;
    *) ERL_FLAGS="${ERL_FLAGS:+${ERL_FLAGS} }+sbwt none +sbwtdcpu none +sbwtdio none" ;;
  esac
  export ERL_FLAGS
fi

# Ensure data directory exists
mkdir -p "$OSA_HOME"
mkdir -p "$OSA_HOME/sessions"
mkdir -p "$OSA_HOME/data"
mkdir -p "$OSA_HOME/skills"

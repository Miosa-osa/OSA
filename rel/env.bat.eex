@echo off
rem OSA release environment (Windows) — runs before every release command.
rem Mirrors rel/env.sh.eex: sets OSA_HOME, disables Erlang distribution
rem (standalone binary), and creates the data directories on first run.

if "%OSA_HOME%"=="" set OSA_HOME=%USERPROFILE%\.osa
set RELEASE_DISTRIBUTION=none
set RELEASE_COOKIE=osa_standalone

rem BEAM scheduler busy-wait: off (issue #66). The schedulers, dirty-CPU and
rem dirty-IO schedulers spin before parking, which is right for a dedicated
rem server and wrong for a warm background daemon that mostly waits on a model.
rem Set OSA_BEAM_BUSY_WAIT=1 to keep the stock OTP behaviour.
if not "%OSA_BEAM_BUSY_WAIT%"=="" goto :osa_skip_sbwt
if not "%ERL_FLAGS%"=="" goto :osa_append_sbwt
set ERL_FLAGS=+sbwt none +sbwtdcpu none +sbwtdio none
goto :osa_skip_sbwt
:osa_append_sbwt
echo %ERL_FLAGS% | findstr /C:"+sbwt" >nul 2>&1
if not errorlevel 1 goto :osa_skip_sbwt
set ERL_FLAGS=%ERL_FLAGS% +sbwt none +sbwtdcpu none +sbwtdio none
:osa_skip_sbwt

if not exist "%OSA_HOME%" mkdir "%OSA_HOME%"
if not exist "%OSA_HOME%\sessions" mkdir "%OSA_HOME%\sessions"
if not exist "%OSA_HOME%\data" mkdir "%OSA_HOME%\data"
if not exist "%OSA_HOME%\skills" mkdir "%OSA_HOME%\skills"

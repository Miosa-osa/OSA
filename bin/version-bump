#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   bin/version-bump patch    0.1.0 → 0.1.1
#   bin/version-bump minor    0.1.0 → 0.2.0
#   bin/version-bump major    0.1.0 → 1.0.0
#   bin/version-bump          (no arg = patch)
#
# Reads VERSION file, bumps it, writes it back, commits, and creates a git tag.
# Push with: git push origin main --tags

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERSION_FILE="$ROOT/VERSION"

if [ ! -f "$VERSION_FILE" ]; then
  echo "error: VERSION file not found at $VERSION_FILE" >&2
  exit 1
fi

CURRENT=$(cat "$VERSION_FILE" | tr -d '[:space:]')
BUMP="${1:-patch}"

# ── Concurrency guards ──────────────────────────────────────────────────
#
# The next version is computed from the LOCAL VERSION file, which is only
# correct if this checkout is actually current. When two machines release the
# same day that assumption breaks, and it breaks silently: a `git pull` that
# aborted on a dirty file leaves VERSION stale, the bump lands on a number
# another machine already published, and you find out when the tag push
# collides — or worse, when it does not.
#
# Each check below refuses rather than guesses. Override with FORCE=1 when you
# genuinely mean it.
cd "$ROOT"

if [ "${FORCE:-0}" != "1" ]; then
  # 1. A dirty tree means VERSION may not reflect what is committed, and it is
  #    what makes `git pull` abort in the first place.
  if [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    echo "error: working tree is dirty — commit or stash first (FORCE=1 to override)." >&2
    git status --short --untracked-files=no >&2
    exit 1
  fi

  git fetch --quiet --tags origin 2>/dev/null || true

  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  UPSTREAM="origin/${BRANCH}"

  # 2. Behind the remote = bumping a stale VERSION. This is the exact shape of
  #    the near-miss that motivated these guards.
  if git rev-parse --verify --quiet "$UPSTREAM" >/dev/null 2>&1; then
    BEHIND="$(git rev-list --count "HEAD..${UPSTREAM}" 2>/dev/null || echo 0)"
    if [ "${BEHIND:-0}" -gt 0 ]; then
      echo "error: ${BRANCH} is ${BEHIND} commit(s) behind ${UPSTREAM}." >&2
      echo "       VERSION here is ${CURRENT}, which is probably not the latest." >&2
      echo "       Run: git pull --ff-only origin ${BRANCH}   (FORCE=1 to override)" >&2
      exit 1
    fi
  fi
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

case "$BUMP" in
  major)
    MAJOR=$((MAJOR + 1))
    MINOR=0
    PATCH=0
    ;;
  minor)
    MINOR=$((MINOR + 1))
    PATCH=0
    ;;
  patch)
    PATCH=$((PATCH + 1))
    ;;
  *)
    echo "usage: bin/version-bump [patch|minor|major]" >&2
    exit 1
    ;;
esac

NEW="${MAJOR}.${MINOR}.${PATCH}"

# 3. The decisive check: does the tag we are about to mint already exist?
#    Local AND remote, because the collision that matters is the one another
#    machine already pushed. Done before anything is written, so a refusal
#    leaves the tree untouched.
CANDIDATE_TAG="v${MAJOR}.${MINOR}.$(printf '%03d' "$PATCH")"

if [ "${FORCE:-0}" != "1" ]; then
  if git rev-parse --verify --quiet "refs/tags/${CANDIDATE_TAG}" >/dev/null 2>&1; then
    echo "error: tag ${CANDIDATE_TAG} already exists locally. Another release already used ${NEW}." >&2
    exit 1
  fi

  if git ls-remote --exit-code --tags origin "refs/tags/${CANDIDATE_TAG}" >/dev/null 2>&1; then
    echo "error: tag ${CANDIDATE_TAG} is already published on origin." >&2
    echo "       Another machine released ${NEW}. Pull, then bump again." >&2
    exit 1
  fi
fi

echo "$NEW" > "$VERSION_FILE"

# Keep the public install examples honest. The README advertises the latest
# published release in both its badge and its pinned-install example, so a
# release bump must update those references in the same tagged commit.
README="$ROOT/README.md"
if [ -f "$README" ]; then
  awk -v old="v${CURRENT}" -v new="v${NEW}" \
    '{gsub(old, new); print}' "$README" > "$README.tmp" && mv "$README.tmp" "$README"
fi

# Keep the Rust TUI crate version in lockstep — single source of truth.
# Cargo/SemVer forbid leading zeros, so the crate version stays plain SemVer.
CARGO_TOML="$ROOT/priv/rust/tui/Cargo.toml"
if [ -f "$CARGO_TOML" ]; then
  # Replace only the first (package) version line, portably (GNU + BSD).
  awk -v v="$NEW" 'BEGIN{d=0} /^version = "[0-9]+\.[0-9]+\.[0-9]+"/ && !d {sub(/"[0-9]+\.[0-9]+\.[0-9]+"/, "\"" v "\""); d=1} {print}' "$CARGO_TOML" > "$CARGO_TOML.tmp" && mv "$CARGO_TOML.tmp" "$CARGO_TOML"
fi

# Release tags use the project's zero-padded patch convention (v1.0.003), while
# VERSION / Cargo stay plain SemVer (1.0.3), which mix + cargo require.
PADDED_PATCH=$(printf "%03d" "$PATCH")
TAG="v${MAJOR}.${MINOR}.${PADDED_PATCH}"

echo "$CURRENT → $NEW  (tag ${TAG})"

cd "$ROOT"
# Keep Cargo.lock in step too. It records osa-tui's own version, so bumping
# only Cargo.toml leaves the lock stale and the tree dirty after every release.
# That dirt is what `osa update` auto-stashes and later reapplies over newer
# code, so an uncommitted lockfile is not cosmetic - it is how a release
# quietly resurrects old source.
CARGO_LOCK="$ROOT/priv/rust/tui/Cargo.lock"
if [ -f "$CARGO_LOCK" ] && command -v cargo >/dev/null 2>&1; then
  (cd "$ROOT/priv/rust/tui" && cargo update --offline --workspace >/dev/null 2>&1) || true
fi

git add VERSION "$CARGO_TOML"
[ -f "$CARGO_LOCK" ] && git add "$CARGO_LOCK"
[ -f "$README" ] && git add "$README"
git commit -m "bump: ${TAG}"
git tag "$TAG"

echo ""
echo "Tagged ${TAG}. Push with:"
echo "  git push origin main --tags"

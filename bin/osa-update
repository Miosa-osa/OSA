#!/usr/bin/env bash
# bin/osa-update — rollback-safe self-update engine for OSA (source checkouts).
#
# Steal-list #15 (grok/codex parity): dual-symlink atomic swap self-update.
#
# Layout under $OSA_HOME (default: $HOME/.osa):
#
#   versions/<rev>/     a fully staged + built checkout at git commit <rev>
#   current             symlink -> versions/<rev>   (the live version)
#   previous            symlink -> versions/<rev>   (the version before the last swap)
#   .update.lock.d/     lock directory held for the duration of a mutating run
#
# Update flow (stage -> build gate -> health gate -> atomic swap):
#
#   1. `git worktree add` a fresh, detached checkout of the target ref into
#      versions/<rev>. This does NOT touch --root's working tree or index, so it's
#      safe even if --root has local uncommitted changes or is mid-rebase.
#   2. Build it there (mix deps.get && mix compile, plus `cargo build --release`
#      for the TUI when present). This is gate #1: a compile failure aborts.
#   3. Boot-probe it: start the built app briefly on an ephemeral port and poll its
#      /health endpoint. This is gate #2: a boot failure aborts.
#   4. Only if 2+3 both succeed: atomically repoint `current` at the new version
#      using a temp-symlink-then-rename (`ln -sfn` + `mv -T`), so the swap is a
#      single filesystem rename. It is never observable as a half-updated tree,
#      and a rename() in flight cannot be left half-done by an interrupt: the
#      kernel either completes it or it never started, so `current` before the
#      swap is always either the old version or the new one, in full.
#      The version `current` pointed at before the swap becomes `previous`,
#      which is what makes `osa update --rollback` possible.
#   5. If 2 or 3 fail: abort. `current` (and thus the running install) is left
#      completely untouched. The failed stage directory is left on disk for
#      inspection unless --keep pruning removes it on a later successful run.
#
# After the swap we re-verify health against `current` itself (belt-and-braces,
# catches swap-time surprises such as a symlink race). If that fails we
# automatically roll back to `previous` so a bad swap can never be the last
# thing that happened.
#
# Rollback (`osa-update rollback`) swaps `current` back to whatever `previous`
# points at (and the old `current` becomes the new `previous`, so you can toggle
# back and forth). It re-verifies health after rolling back and reports failure
# (without further mutation) if even the previous version won't boot.
#
# Robustness:
#   - `update` and `rollback` both take an exclusive lock (a plain, portable
#     mkdir-based lock under $OSA_HOME/.update.lock.d) so two runs can never
#     race each other. A held lock from a process that's no longer alive is
#     detected (by pid) and cleared automatically; a lock held by a live
#     process aborts immediately with a clear message.
#   - Ctrl+C / SIGTERM at any point before the swap leaves `current` exactly
#     as it was; a stray temp symlink from an interrupted swap is cleaned up
#     on exit. The lock is always released on exit, including on interrupt.
#   - Permission and disk-space failures on $OSA_HOME are caught up front and
#     reported plainly instead of surfacing a raw `mkdir`/`ln` error.
#
# This script is a pure filesystem + git tool: it only touches --root (read-only:
# fetch + worktree add) and --home (versions/current/previous). It never reads or
# writes any of OSA's own OSA_HOME runtime state (logs/run/backend.pid/etc), so it
# is safe to exercise end-to-end against a throwaway --home in tests. See
# test/shell/self_update_test.sh.
#
# Caveat (intentionally not implemented): this does not verify a checksum or
# signature on the fetched commit/tag, same caveat steal-list #15 calls out for
# grok/codex's `--version`-only self-update. Fine for a trusted git remote over
# HTTPS; would need a signature check before ever being used against a hostile
# network.

set -euo pipefail

# ── Colors (only when attached to a tty; identical palette to bin/osa) ────────
if [ -t 1 ]; then
  BOLD='\033[1m'; DIM='\033[2m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
  RED='\033[0;31m'; CYAN='\033[0;36m'; RESET='\033[0m'
else
  BOLD='' DIM='' GREEN='' YELLOW='' RED='' CYAN='' RESET=''
fi
info()  { echo -e "${CYAN}→${RESET} $*"; }
ok()    { echo -e "${GREEN}✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET} $*" >&2; }
err()   { echo -e "${RED}✗${RESET} $*" >&2; }
abort() { err "$*"; exit 1; }

PHASE_TOTAL=5
phase() {
  echo ""
  echo -e "${BOLD}${CYAN}[$1/${PHASE_TOTAL}]${RESET} ${BOLD}$2${RESET}"
}

# Spinner over a background pid; a no-op (blocks silently) when not a tty, so
# CI logs and piped output stay clean. Caller still does `wait "$pid"` after.
spin_while() {
  local pid="$1" label="$2"
  [ -t 1 ] || return 0
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r  %b%s%b %s...' "$CYAN" "${frames[$((i % 10))]}" "$RESET" "$label" >&2
    i=$((i + 1))
    sleep 0.15
  done
  printf '\r\033[K' >&2
}

# ── HTTP probe helper (curl -> wget fallback, mirrors bin/osa's _http_ok) ─────
_http_ok() {
  if command -v curl >/dev/null 2>&1; then
    curl -sf "$1" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO /dev/null "$1" 2>/dev/null
  else
    return 1
  fi
}

usage() {
  cat <<'EOF'
osa-update: rollback-safe self-update engine for OSA source checkouts

Usage:
  osa-update update   --root <git-checkout> [--home <osa-home>] [--ref <git-ref>]
                       [--keep <n>] [--dry-run]
  osa-update rollback [--home <osa-home>] [--dry-run]
  osa-update status   [--home <osa-home>]

Options:
  --root <path>    Git checkout to fetch the update from (required for `update`)
  --home <path>    OSA home holding versions/current/previous (default: $HOME/.osa)
  --ref <ref>      Git ref to update to (default: origin/main)
  --keep <n>       Number of old staged versions to retain (default: 3)
  --dry-run        Print the planned steps; never mutate any filesystem state

Environment overrides (mainly for tests, see test/shell/self_update_test.sh):
  OSA_UPDATE_BUILD_CMD   Shell command run inside the staged checkout to build it.
                         Receives $STAGE_DIR as cwd. Default: mix deps.get && mix
                         compile (+ cargo build --release for the TUI if present).
  OSA_UPDATE_HEALTH_CMD  Shell command run to boot-probe a staged/current checkout.
                         Receives $STAGE_DIR (cwd) and $PROBE_PORT (env). Default:
                         a short-lived `mix osa.serve` polled against /health.
EOF
}

SUBCMD="${1:-}"; shift || true
[ -n "$SUBCMD" ] || { usage; exit 2; }

ROOT=""
OSA_HOME_ARG="${HOME:-}/.osa"
REF="origin/main"
KEEP=3
DRY_RUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --home) OSA_HOME_ARG="$2"; shift 2 ;;
    --ref) REF="$2"; shift 2 ;;
    --keep) KEEP="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) abort "unknown flag: $1 (see --help)" ;;
  esac
done

OSA_HOME="$OSA_HOME_ARG"
VERSIONS_DIR="$OSA_HOME/versions"
CURRENT_LINK="$OSA_HOME/current"
PREVIOUS_LINK="$OSA_HOME/previous"
LOCK_DIR="$OSA_HOME/.update.lock.d"

# ── Lock: mkdir is atomic on every POSIX filesystem, so this is race-free
# without depending on flock being installed. A lock left by a process that
# is no longer alive (e.g. the machine lost power mid-update) is detected by
# pid and cleared automatically instead of wedging every future update. ─────
LOCK_ACQUIRED=0

# Classify a pid as alive / foreign / gone.
#
# `kill -0` conflates two very different answers in its exit status: ESRCH
# ("no such process", the lock IS stale) and EPERM ("process exists, not
# yours", the lock is emphatically NOT stale). The old code read any non-zero
# status as stale and deleted the lock — so a multi-user or container-uid
# mismatch silently removed the lock guarding somebody else's running update.
# stderr distinguishes them; where /proc exists it is checked first because it
# answers directly and without parsing localized text.
pid_state() {
  local pid="$1" err
  [ -n "$pid" ] || { echo gone; return; }
  case "$pid" in
    ''|*[!0-9]*) echo gone; return ;;
  esac

  if [ -d /proc ] && [ -e /proc/1 ]; then
    if [ -d "/proc/$pid" ]; then echo alive; else echo gone; fi
    return
  fi

  if kill -0 "$pid" 2>/dev/null; then
    echo alive
    return
  fi
  err="$(kill -0 "$pid" 2>&1 >/dev/null || true)"
  case "$err" in
    *[Pp]ermission*|*[Nn]ot\ permitted*|*EPERM*) echo foreign ;;
    *) echo gone ;;
  esac
}

acquire_lock() {
  mkdir -p "$OSA_HOME" 2>/dev/null \
    || abort "cannot create '$OSA_HOME'. Check permissions and free disk space, then retry."
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local lpid=""
    [ -f "$LOCK_DIR/pid" ] && lpid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    case "$(pid_state "$lpid")" in
      alive)
        abort "another 'osa update' is already running (pid $lpid). Wait for it to finish, then try again."
        ;;
      # EPERM: the process EXISTS, we just don't own it (another user, or a
      # different uid inside a container). Deleting the lock here would let us
      # run concurrently with a live update and race it over the same
      # $VERSIONS_DIR and `current` symlink. Refuse instead — a stuck update is
      # recoverable by hand, two simultaneous updates are not.
      foreign)
        abort "another 'osa update' is already running as a different user (pid $lpid). Wait for it to finish. If you are certain it is gone, remove '$LOCK_DIR' by hand."
        ;;
    esac
    warn "clearing a stale update lock left by process ${lpid:-unknown} (not running)"
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    mkdir "$LOCK_DIR" 2>/dev/null \
      || abort "could not acquire the update lock at '$LOCK_DIR'. Check permissions on $OSA_HOME."
  fi
  echo $$ > "$LOCK_DIR/pid" 2>/dev/null || true
  LOCK_ACQUIRED=1
}
release_lock() {
  if [ "$LOCK_ACQUIRED" = 1 ]; then
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    LOCK_ACQUIRED=0
  fi
}
on_exit() {
  local rc=$?
  release_lock
  # A crash between `ln -sfn tmp` and `mv tmp linkpath` can only ever leave the
  # tmp file behind (the rename itself is atomic and cannot be half-done), so
  # cleaning up our own pid-tagged tmp names on exit is always safe.
  rm -f "$CURRENT_LINK".tmp."$$" "$PREVIOUS_LINK".tmp."$$" 2>/dev/null || true
  exit "$rc"
}
on_interrupt() {
  warn "Interrupted. Current install left untouched."
  exit 130
}
trap on_exit EXIT
trap on_interrupt INT TERM

# ── Permission / disk-space sanity check, up front and in plain language ──────
check_writable() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null \
    || abort "cannot create '$dir'. Check permissions and free disk space under $OSA_HOME."
  local probe="$dir/.osa-update-write-test.$$"
  if ! ( : > "$probe" ) 2>/dev/null; then
    abort "no write permission in '$dir'. Check ownership/permissions on $OSA_HOME (or free up disk space if it's full)."
  fi
  rm -f "$probe" 2>/dev/null || true
}

# ── Atomic symlink swap: temp symlink + rename (never a half-updated tree) ────
atomic_symlink() {
  local target="$1" linkpath="$2" tmp
  tmp="${linkpath}.tmp.$$"
  if ! ln -sfn "$target" "$tmp" 2>/dev/null; then
    abort "failed to create a symlink under '$(dirname "$linkpath")'. Check permissions and free disk space under $OSA_HOME (current install left untouched)."
  fi
  if mv -T "$tmp" "$linkpath" 2>/dev/null; then
    return 0
  fi
  # Non-GNU mv (e.g. BSD/macOS) has no -T; a plain `mv src dst` where dst exists
  # as a symlink (not a directory) still does an atomic rename: mv only follows
  # dst into a directory when dst itself resolves to a directory, and dst here is
  # always a symlink node (even when its target is a dir), so this path is safe.
  if ! mv -f "$tmp" "$linkpath" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null || true
    abort "failed to swap '$linkpath' into place. Check permissions and free disk space under $OSA_HOME (current install left untouched)."
  fi
}

# True when $1 names a MOVING remote-tracking ref (origin/main, refs/remotes/…)
# whose value only becomes trustworthy after a successful fetch — as opposed to
# a pinned commit sha or tag, which means the same thing offline.
ref_is_remote_tracking() {
  case "$1" in
    origin/*|refs/remotes/*) return 0 ;;
  esac
  git -C "$ROOT" rev-parse --verify --quiet "refs/remotes/$1" >/dev/null 2>&1
}

read_version() {
  local dir="$1"
  if [ -f "$dir/VERSION" ]; then
    tr -d '[:space:]' < "$dir/VERSION" 2>/dev/null || echo "unknown"
  else
    echo "unknown"
  fi
}

# Print the first version section of a CHANGELOG file (capped), so the user
# sees what actually changed without leaving the terminal.
print_changelog_top() {
  local dir="$1" changelog
  changelog="$dir/priv/CHANGELOG.md"
  [ -f "$changelog" ] || changelog="$dir/docs/operations/changelog.md"
  [ -f "$changelog" ] || return 0
  echo ""
  echo -e "  ${BOLD}What's new${RESET}"
  awk '
    /^## \[/ { hdr++; if (hdr > 1) exit }
    hdr >= 1 && shown < 24 { print "    " $0; shown++ }
  ' "$changelog" 2>/dev/null || true
}

# The ONE env both gates use. This used to be two different answers: the build
# ran with whatever MIX_ENV happened to be inherited (i.e. `dev`), while the
# health check hardcoded a fallback to `prod`. The result was a gate that
# booted an artifact the build had never produced — it either recompiled from
# scratch inside the probe's 40s timeout, or, worse, booted a *stale* prod
# build left over from an earlier version and passed. A green gate then said
# nothing at all about the code being installed. Same value, both gates, or the
# gate is theatre.
OSA_UPDATE_MIX_ENV="${OSA_UPDATE_MIX_ENV:-${MIX_ENV:-prod}}"

# ── Build (gate #1) ────────────────────────────────────────────────────────
run_build() {
  local stage="$1"
  if [ -n "${OSA_UPDATE_BUILD_CMD:-}" ]; then
    ( cd "$stage" && STAGE_DIR="$stage" MIX_ENV="$OSA_UPDATE_MIX_ENV" bash -c "$OSA_UPDATE_BUILD_CMD" )
    return $?
  fi
  (
    cd "$stage"
    export MIX_ENV="$OSA_UPDATE_MIX_ENV"
    mix local.hex --force --if-missing >/dev/null 2>&1 || true
    mix local.rebar --force --if-missing >/dev/null 2>&1 || true
    mix deps.get
    mix compile
    if [ -f "priv/rust/tui/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
      ( cd priv/rust/tui && cargo build --release )
    fi
  )
}

# ── Boot probe (gate #2) ───────────────────────────────────────────────────
run_health_check() {
  local stage="$1" port="$2" label="${3:-booting}"
  if [ -n "${OSA_UPDATE_HEALTH_CMD:-}" ]; then
    ( cd "$stage" && STAGE_DIR="$stage" PROBE_PORT="$port" MIX_ENV="$OSA_UPDATE_MIX_ENV" \
        bash -c "$OSA_UPDATE_HEALTH_CMD" )
    return $?
  fi
  local pid rc=1 i
  (
    cd "$stage"
    OSA_PORT="$port" MIX_ENV="$OSA_UPDATE_MIX_ENV" timeout 40 mix osa.serve \
      >"$stage/.osa-update-probe.log" 2>&1 &
    echo $! > "$stage/.osa-update-probe.pid"
  )
  pid="$(cat "$stage/.osa-update-probe.pid" 2>/dev/null || true)"
  for i in $(seq 1 25); do
    if _http_ok "http://localhost:${port}/health"; then rc=0; break; fi
    if [ -t 1 ]; then
      local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
      printf '\r  %b%s%b %s on :%s...' "$CYAN" "${frames[$((i % 10))]}" "$RESET" "$label" "$port" >&2
    fi
    sleep 1
  done
  [ -t 1 ] && printf '\r\033[K' >&2
  [ -n "$pid" ] && kill "$pid" >/dev/null 2>&1 || true
  [ -n "$pid" ] && wait "$pid" 2>/dev/null || true
  rm -f "$stage/.osa-update-probe.pid"
  return $rc
}

pick_probe_port() {
  # Ephemeral, unlikely to collide with a live daemon (default 9089 / 19001).
  echo $(( 40000 + (RANDOM % 20000) ))
}

cleanup_stage() {
  local root="$1" stage="$2"
  ( git -C "$root" worktree remove --force "$stage" 2>/dev/null ) || rm -rf "$stage"
}

# Every staged version in $VERSIONS_DIR is a git worktree (see cmd_update's
# `git worktree add`). A bare `rm -rf` deletes the checkout but leaves git's
# administrative record of it in $ROOT/.git/worktrees — so git still believes
# a worktree is registered at that path, and the next `git worktree add`
# targeting it fails with "already exists". Pruning enough versions wedged
# every future update, which is exactly the self-sealing failure this tool has
# shipped once already.
#
# `git worktree remove` deregisters and deletes together. If that fails (not a
# worktree, git absent, $ROOT gone), fall back to rm -rf and then `prune` to
# garbage-collect any record pointing at the now-missing path.
remove_version_dir() {
  local d="$1"
  if [ -n "${ROOT:-}" ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if git -C "$ROOT" worktree remove --force "$d" >/dev/null 2>&1; then
      return 0
    fi
  fi
  rm -rf "$d" 2>/dev/null || true
  if [ -n "${ROOT:-}" ]; then
    git -C "$ROOT" worktree prune >/dev/null 2>&1 || true
  fi
}

prune_old_versions() {
  [ -d "$VERSIONS_DIR" ] || return 0
  local keep_cur keep_prev d dirs mtime_sorted n=0
  keep_cur="$( [ -L "$CURRENT_LINK" ] && readlink "$CURRENT_LINK" || true )"
  keep_prev="$( [ -L "$PREVIOUS_LINK" ] && readlink "$PREVIOUS_LINK" || true )"
  mtime_sorted="$(find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | awk '{print $2}')"
  [ -n "$mtime_sorted" ] || return 0
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    if [ "$d" = "$keep_cur" ] || [ "$d" = "$keep_prev" ]; then continue; fi
    n=$((n + 1))
    if [ "$n" -gt "$KEEP" ]; then
      remove_version_dir "$d"
    fi
  done <<< "$mtime_sorted"
}

# ── status ──────────────────────────────────────────────────────────────────
cmd_status() {
  echo "OSA_HOME: $OSA_HOME"
  if [ -L "$CURRENT_LINK" ]; then
    echo "current:  $(readlink "$CURRENT_LINK") (v$(read_version "$CURRENT_LINK"))"
  else
    echo "current:  (not staged, using in-place source checkout)"
  fi
  if [ -L "$PREVIOUS_LINK" ]; then
    echo "previous: $(readlink "$PREVIOUS_LINK") (v$(read_version "$PREVIOUS_LINK"))"
  else
    echo "previous: (none)"
  fi
  if [ -d "$VERSIONS_DIR" ]; then
    echo "versions:"
    find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sed 's/^/  - /'
  fi
  if [ -d "$LOCK_DIR" ]; then
    echo "lock:     held (pid $(cat "$LOCK_DIR/pid" 2>/dev/null || echo unknown))"
  fi
}

# ── update ──────────────────────────────────────────────────────────────────
cmd_update() {
  [ -n "$ROOT" ] || abort "update requires --root <git-checkout>"
  [ -d "$ROOT/.git" ] || abort "--root '$ROOT' is not a git checkout, a staged update needs git"
  command -v git >/dev/null 2>&1 || abort "git is required for staged updates"

  phase 1 "Checking for updates"

  local old_target="" cur_rev="none" cur_ver="unknown"
  if [ -L "$CURRENT_LINK" ]; then
    old_target="$(readlink "$CURRENT_LINK")"
    cur_rev="$(basename "$old_target")"
    cur_ver="$(read_version "$CURRENT_LINK")"
  else
    cur_ver="$(read_version "$ROOT")"
  fi
  info "Current: v${cur_ver} (${cur_rev})"

  info "Fetching latest ($REF)..."
  local fetch_ok=1
  git -C "$ROOT" fetch --quiet --tags origin >/dev/null 2>&1 \
    || { fetch_ok=0; warn "fetch failed (offline or remote unreachable), resolving '$REF' from local refs"; }

  local target_rev
  target_rev="$(git -C "$ROOT" rev-parse --short=12 "$REF" 2>/dev/null)" \
    || abort "could not resolve ref '$REF' in '$ROOT'. Check the ref name and that '$ROOT' has fetched it."

  if [ "$target_rev" = "$cur_rev" ]; then
    # Same hole as the in-place path used to have: if the fetch failed we are
    # comparing against a STALE local ref, so "already up to date" would be an
    # assertion we cannot back up. Fail loudly instead of printing a green tick.
    #
    # Only MOVING refs are affected. `--ref <sha>` (or a tag) is pinned: its
    # meaning does not depend on the fetch, so "up to date with that exact
    # commit" stays a true statement offline. Restricting this to
    # remote-tracking refs keeps offline pinned updates working.
    if [ "$fetch_ok" != 1 ] && ref_is_remote_tracking "$REF"; then
      err "Cannot confirm you are up to date: the fetch from origin failed, so '$REF' is a stale local ref."
      warn "You are on v${cur_ver} (${target_rev}); there may be newer commits on origin."
      warn "Check your network, then retry: git -C '$ROOT' fetch origin"
      exit 1
    fi
    ok "Already up to date: v${cur_ver} (${target_rev})"
    exit 0
  fi

  if [ "$DRY_RUN" != 1 ]; then
    check_writable "$OSA_HOME"
    acquire_lock
  fi

  local stage port
  stage="$VERSIONS_DIR/$target_rev"
  port="$(pick_probe_port)"

  if [ "$DRY_RUN" = 1 ]; then
    echo -e "${BOLD}Planned staged update (dry-run, nothing will be changed)${RESET}"
    echo "  1. stage:  git -C '$ROOT' worktree add --detach '$stage' '$target_rev'"
    echo "  2. build:  (in '$stage') mix deps.get && mix compile [+ cargo build --release]"
    echo "  3. health: boot-probe '$stage' on 127.0.0.1:$port, poll /health"
    echo "  4. swap:   atomic_symlink '$stage' -> '$CURRENT_LINK'"
    echo "             atomic_symlink '${old_target:-<bootstrap:$ROOT>}' -> '$PREVIOUS_LINK'"
    echo "  5. prune:  keep newest $KEEP staged versions (plus current/previous)"
    echo "  from: v${cur_ver} (${cur_rev})  to: ${target_rev}"
    exit 0
  fi

  phase 2 "Staging ${target_rev}"
  mkdir -p "$VERSIONS_DIR" 2>/dev/null \
    || abort "cannot create '$VERSIONS_DIR'. Check disk space and permissions under $OSA_HOME."
  check_writable "$VERSIONS_DIR"
  rm -rf "$stage" 2>/dev/null || true
  info "Fetching commit into $stage..."
  git -C "$ROOT" worktree add --detach "$stage" "$target_rev" >/dev/null \
    || abort "git worktree add failed, aborting (current install untouched)"
  local target_ver
  target_ver="$(read_version "$stage")"
  ok "Staged v${target_ver} (${target_rev})"

  phase 3 "Building (~60s)"
  ( run_build "$stage" ) >"$stage/.osa-update-build.log" 2>&1 &
  local build_pid=$!
  spin_while "$build_pid" "compiling"
  if ! wait "$build_pid"; then
    err "Build failed for v${target_ver} (${target_rev}). Current install untouched."
    warn "build log: $stage/.osa-update-build.log"
    tail -n 20 "$stage/.osa-update-build.log" 2>/dev/null >&2 || true
    cleanup_stage "$ROOT" "$stage"
    exit 1
  fi
  ok "Build succeeded"

  phase 4 "Health check"
  if ! run_health_check "$stage" "$port" "booting"; then
    err "Health check failed for v${target_ver} (${target_rev}). Current install untouched."
    cleanup_stage "$ROOT" "$stage"
    exit 1
  fi
  ok "Boots cleanly"

  phase 5 "Switching"
  info "current -> v${target_ver} (${target_rev})"
  atomic_symlink "$stage" "$CURRENT_LINK"
  if [ -n "$old_target" ]; then
    atomic_symlink "$old_target" "$PREVIOUS_LINK"
  else
    # First staged update on a previously in-place install: remember the
    # original checkout itself as the rollback target.
    local bootstrap_link
    bootstrap_link="$VERSIONS_DIR/bootstrap-$(git -C "$ROOT" rev-parse --short=12 HEAD 2>/dev/null || echo root)"
    [ -e "$bootstrap_link" ] || ln -s "$ROOT" "$bootstrap_link"
    atomic_symlink "$bootstrap_link" "$PREVIOUS_LINK"
  fi

  info "Verifying the swapped-in version still boots..."
  if ! run_health_check "$CURRENT_LINK" "$(pick_probe_port)" "verifying"; then
    err "Post-swap health check failed. Automatically rolling back to v${cur_ver} (${cur_rev})."
    do_rollback_swap
    prune_old_versions
    exit 1
  fi
  ok "Switched: v${cur_ver} -> v${target_ver}"

  prune_old_versions

  echo ""
  ok "Updated v${cur_ver} -> v${target_ver} (${cur_rev} -> ${target_rev})"
  print_changelog_top "$stage"
  echo ""
  echo -e "  ${DIM}Roll back anytime with: ${RESET}${CYAN}osa update --rollback${RESET}"
}

# ── rollback ────────────────────────────────────────────────────────────────
do_rollback_swap() {
  local prev_target cur_target
  [ -L "$PREVIOUS_LINK" ] || abort "no 'previous' version recorded, nothing to roll back to"
  prev_target="$(readlink "$PREVIOUS_LINK")"
  cur_target="$( [ -L "$CURRENT_LINK" ] && readlink "$CURRENT_LINK" || true )"
  atomic_symlink "$prev_target" "$CURRENT_LINK"
  [ -n "$cur_target" ] && atomic_symlink "$cur_target" "$PREVIOUS_LINK"
}

cmd_rollback() {
  [ -L "$PREVIOUS_LINK" ] || abort "no 'previous' version recorded under $OSA_HOME, nothing to roll back to"
  local prev_target cur_ver prev_ver
  prev_target="$(readlink "$PREVIOUS_LINK")"
  cur_ver="$(read_version "$CURRENT_LINK")"
  prev_ver="$(read_version "$PREVIOUS_LINK")"

  if [ "$DRY_RUN" = 1 ]; then
    echo -e "${BOLD}Planned rollback (dry-run, nothing will be changed)${RESET}"
    echo "  current -> $prev_target (v${prev_ver})"
    echo "  previous -> $( [ -L "$CURRENT_LINK" ] && readlink "$CURRENT_LINK" || echo '(none)') (v${cur_ver})"
    exit 0
  fi

  check_writable "$OSA_HOME"
  acquire_lock

  info "Rolling back: v${cur_ver} -> v${prev_ver} ($(basename "$prev_target"))..."
  do_rollback_swap

  local port
  port="$(pick_probe_port)"
  if run_health_check "$CURRENT_LINK" "$port" "verifying"; then
    ok "Rolled back to v${prev_ver} ($(basename "$prev_target")), verified healthy"
  else
    err "Rolled back to v${prev_ver} ($(basename "$prev_target")) but it failed its own health check. Install may be broken, inspect $CURRENT_LINK manually."
    exit 1
  fi
}

case "$SUBCMD" in
  update)   cmd_update ;;
  rollback) cmd_rollback ;;
  status)   cmd_status ;;
  -h|--help) usage ;;
  *) usage; exit 2 ;;
esac

#!/usr/bin/env bash
# bin/osa — the one command to run OSA (source checkout).
#
# `osa` is seamless: no separate backend to babysit, no bin/ to remember.
# The first `osa` warms a background ERTS backend (a daemon that survives TUI
# exit), then drops you into the TUI. Every `osa` after that attaches instantly.
#
# Commands:
#   osa                    Attach the TUI (warms the backend daemon if needed)
#   osa overdrive          Launch in overdrive (full auto) — no approval prompts
#   osa continue           Resume the newest session in this directory
#   osa resume [id]        Resume a specific session (or pick one)
#   osa stop               Stop the background backend daemon
#   osa setup              Run the setup wizard
#   osa update             Update in place, show what's new, then launch
#   osa doctor             Run backend health checks
#   osa serve              Run the backend in the foreground (headless API)
#   osa version            Print version
#   osa help               Show this help
#
# Flags (passed through to the TUI):
#   --overdrive                        Full-auto mode (same as `osa overdrive`)
#   --dangerously-skip-permissions     Silent alias for --overdrive
#   --continue                         Resume newest session here
#   --resume [id]                      Resume a session
#   --permission-mode <mode>           ask | auto-edit | plan | overdrive
#   --dev                              Dev profile (port 19001)

set -euo pipefail

# ── Safe defaults ────────────────────────────────────────────────
HOME="${HOME:-/root}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

# sudo helper: skip when already root
if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
else
  SUDO="sudo"
fi

# ── Colors (OSA blue identity) ───────────────────────────────────
if [ -t 1 ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  RED='\033[0;31m'
  CYAN='\033[0;36m'
  BLUE='\033[0;34m'
  RESET='\033[0m'
else
  BOLD='' DIM='' GREEN='' YELLOW='' RED='' CYAN='' BLUE='' RESET=''
fi

# ── Detect package manager ───────────────────────────────────────
detect_pkg() {
  if   command -v apt-get >/dev/null 2>&1; then PKG="apt"
  elif command -v dnf     >/dev/null 2>&1; then PKG="dnf"
  elif command -v pacman  >/dev/null 2>&1; then PKG="pacman"
  elif command -v apk     >/dev/null 2>&1; then PKG="apk"
  elif command -v zypper  >/dev/null 2>&1; then PKG="zypper"
  elif command -v yum     >/dev/null 2>&1; then PKG="yum"
  elif command -v brew    >/dev/null 2>&1; then PKG="brew"
  else PKG="unknown"
  fi
}

# Package install abstraction
pkg_install() {
  case "$PKG" in
    apt)    $SUDO apt-get install -y -qq "$@" ;;
    dnf)    $SUDO dnf install -y -q "$@" ;;
    yum)    $SUDO yum install -y -q "$@" ;;
    pacman) $SUDO pacman -Sy --noconfirm "$@" ;;
    apk)    $SUDO apk add --no-cache "$@" ;;
    zypper) $SUDO zypper install -y "$@" ;;
    brew)   brew install "$@" ;;
    *)      return 1 ;;
  esac
}

# ── HTTP helper (curl → wget fallback) ───────────────────────────
_http_ok() {
  if command -v curl >/dev/null 2>&1; then
    curl -sf "$1" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO /dev/null "$1" 2>/dev/null
  else
    return 1
  fi
}

# Elixir version check (>= 1.17)
check_elixir_version() {
  local ver major minor
  ver=$(elixir --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  [ -z "$ver" ] && return 1
  major=$(echo "$ver" | cut -d. -f1)
  minor=$(echo "$ver" | cut -d. -f2)
  [ "${major:-0}" -gt 1 ] && return 0
  [ "${major:-0}" -eq 1 ] && [ "${minor:-0}" -ge 17 ] && return 0
  return 1
}

# ── Resolve project root ──────────────────────────────────────────
SCRIPT="$0"
if [ -L "$SCRIPT" ]; then
  SCRIPT="$(readlink -f "$SCRIPT" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$SCRIPT" 2>/dev/null || perl -e 'use Cwd "abs_path"; print abs_path(shift)' "$SCRIPT")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"

if [ -f "$SCRIPT_DIR/../mix.exs" ]; then
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -f "${HOME}/.osa/project_root" ]; then
  ROOT="$(cat "${HOME}/.osa/project_root")"
else
  echo -e "${RED}Error: Cannot find OSA project root.${RESET}"
  echo "Run the installer: curl -fsSL https://raw.githubusercontent.com/Miosa-osa/OSA/main/scripts/install.sh | sh"
  exit 1
fi

TUI_DIR="$ROOT/priv/rust/tui"
TUI_BIN="$TUI_DIR/target/release/osagent"
OSA_HOME="${OSA_HOME:-${HOME}/.osa}"
LOG_DIR="$OSA_HOME/logs"
RUN_DIR="$OSA_HOME/run"
PID_FILE="$RUN_DIR/backend.pid"
PORT_FILE="$RUN_DIR/backend.port"
LOG_FILE="$LOG_DIR/backend.log"

mkdir -p "$LOG_DIR" "$RUN_DIR"

# ── Resolve backend port (honor --dev anywhere in args) ──────────
PORT="${OSA_PORT:-9089}"
for _a in "$@"; do
  [ "$_a" = "--dev" ] && PORT="${OSA_PORT:-19001}"
done
HEALTH_URL="http://localhost:${PORT}/health"

# ── Daemon helpers ────────────────────────────────────────────────
backend_healthy() { _http_ok "$HEALTH_URL"; }

daemon_pid() {
  # Echo the live daemon PID, or nothing. Prefers the pidfile, falls back to
  # whatever is listening on our port (covers daemons started out-of-band).
  local pid=""
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"; return 0
    fi
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti ":${PORT}" -sTCP:LISTEN 2>/dev/null | head -1
  fi
}

clear_stale_pid() {
  # Drop a pidfile whose process is gone and whose port is dead.
  if [ -f "$PID_FILE" ]; then
    local pid; pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    fi
  fi
}

stop_daemon() {
  local pid; pid="$(daemon_pid)"
  if [ -z "$pid" ]; then
    echo -e "${DIM}No OSA backend is running on :${PORT}.${RESET}"
    rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    return 0
  fi
  echo -e "${CYAN}→${RESET} Stopping OSA backend (pid ${pid})…"
  # Prefer a process-group kill (the daemon is a setsid group leader, so this
  # also reaps the BEAM/erl child that mix spawns); fall back to the bare pid.
  kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  local n=0
  while [ $n -lt 20 ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25; n=$((n + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
  echo -e "${GREEN}✓${RESET} Backend stopped."
}

# Spinner while waiting for /health. Returns 0 healthy, 1 timeout, 2 died.
# Re-reads the pidfile each tick so daemon death is caught even before the
# child has finished writing its PID.
wait_health() {
  local max="${1:-90}"
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0 n=0 pid
  local ticks=$((max * 2))
  while [ $n -lt $ticks ]; do
    if backend_healthy; then
      [ -t 2 ] && printf '\r\033[K' >&2
      return 0
    fi
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      [ -t 2 ] && printf '\r\033[K' >&2
      return 2
    fi
    if [ -t 2 ]; then
      printf '\r  %b%s%b warming OSA backend…' "$CYAN" "${frames[$((i % 10))]}" "$RESET" >&2
      i=$((i + 1))
    fi
    sleep 0.5
    n=$((n + 1))
  done
  [ -t 2 ] && printf '\r\033[K' >&2
  return 1
}

# Start the backend as a detached warm daemon (survives TUI exit + terminal
# close). Records the real backend PID so `osa stop` can reach it.
start_daemon() {
  : > "$LOG_FILE"
  echo -e "${CYAN}→${RESET} Starting OSA backend on :${PORT} ${DIM}(background daemon)${RESET}"
  if command -v setsid >/dev/null 2>&1; then
    # The child writes its own PID (which `exec` preserves through to mix), so
    # the pidfile always points at the live backend regardless of setsid fork.
    setsid bash -c 'echo $$ > "'"$PID_FILE"'"; cd "'"$ROOT"'"; exec mix osa.serve' \
      >"$LOG_FILE" 2>&1 < /dev/null &
  else
    ( cd "$ROOT" && nohup mix osa.serve >"$LOG_FILE" 2>&1 < /dev/null & echo $! > "$PID_FILE" )
    disown 2>/dev/null || true
  fi
  echo "$PORT" > "$PORT_FILE"
}

# ── Help ──────────────────────────────────────────────────────────
print_help() {
  echo ""
  echo -e "${CYAN}${BOLD}    ___  ____    _   ${RESET}"
  echo -e "${CYAN}${BOLD}   / _ \\/ ___|  / \\  ${RESET}   ${BOLD}OSA${RESET} — the Optimal System Agent"
  echo -e "${CYAN}${BOLD}  | | | \\___ \\ / _ \\ ${RESET}   ${DIM}Your OS, supercharged.${RESET}"
  echo -e "${CYAN}${BOLD}  | |_| |___) / ___ \\${RESET}"
  echo -e "${CYAN}${BOLD}   \\___/|____/_/   \\_\\${RESET}"
  echo ""
  echo -e "  ${BOLD}Usage:${RESET} ${CYAN}osa${RESET} ${DIM}[command] [flags]${RESET}"
  echo ""
  echo -e "  ${BOLD}Commands${RESET}"
  echo -e "    ${CYAN}osa${RESET}                  Attach the TUI ${DIM}(warms the backend daemon if needed)${RESET}"
  echo -e "    ${CYAN}osa overdrive${RESET}        Launch in ${RED}overdrive (full auto)${RESET} ${DIM}— skips approval prompts${RESET}"
  echo -e "    ${CYAN}osa continue${RESET}         Resume the newest session in this folder"
  echo -e "    ${CYAN}osa resume${RESET} ${DIM}[id]${RESET}      Resume a specific session ${DIM}(or pick one)${RESET}"
  echo -e "    ${CYAN}osa stop${RESET}             Stop the background backend daemon"
  echo -e "    ${CYAN}osa setup${RESET}            Run the setup wizard ${DIM}(provider / API keys)${RESET}"
  echo -e "    ${CYAN}osa update${RESET}           Update in place, show what's new, then launch"
  echo -e "    ${CYAN}osa doctor${RESET}           Run backend health checks"
  echo -e "    ${CYAN}osa serve${RESET}            Run the backend in the foreground ${DIM}(headless API)${RESET}"
  echo -e "    ${CYAN}osa version${RESET}          Print version"
  echo -e "    ${CYAN}osa help${RESET}             Show this help"
  echo ""
  echo -e "  ${BOLD}Flags${RESET} ${DIM}(forwarded to the TUI)${RESET}"
  echo -e "    ${CYAN}--overdrive${RESET}                     Full-auto mode ${DIM}(same as ${RESET}${CYAN}osa overdrive${RESET}${DIM})${RESET}"
  echo -e "    ${CYAN}--continue${RESET}                      Resume newest session here"
  echo -e "    ${CYAN}--resume${RESET} ${DIM}[id]${RESET}                 Resume a session"
  echo -e "    ${CYAN}--permission-mode${RESET} ${DIM}<mode>${RESET}      ask · auto-edit · plan · overdrive"
  echo -e "    ${CYAN}--dev${RESET}                           Dev profile ${DIM}(port 19001)${RESET}"
  echo ""
  echo -e "  ${DIM}The backend keeps running in the background so the next ${RESET}${CYAN}osa${RESET}${DIM} is instant."
  echo -e "  ${DIM}Stop it any time with ${RESET}${CYAN}osa stop${RESET}${DIM}; it also idles down when unused.${RESET}"
  echo ""
}

# Red warning before entering overdrive (the TUI shows the one-time confirm).
warn_overdrive() {
  echo -e "${RED}${BOLD}  ⚠ OVERDRIVE (full auto)${RESET}${RED} — OSA will act without asking for approval.${RESET}" >&2
  echo -e "${DIM}    Only use this in a directory you trust. Confirm inside the TUI to proceed.${RESET}" >&2
}

# ── Update (source checkout): git pull + rebuild, show what's new ─
do_update_source() {
  echo -e "${CYAN}→${RESET} Updating OSA ${DIM}(source checkout: $ROOT)${RESET}"
  local old_ver new_ver
  old_ver="$(cat "$ROOT/VERSION" 2>/dev/null || echo unknown)"

  if [ -d "$ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    echo -e "${CYAN}→${RESET} Fetching latest…"
    ( cd "$ROOT" && git fetch --quiet --tags origin 2>/dev/null ) || \
      echo -e "${YELLOW}⚠${RESET} git fetch failed — updating from local tree."
    if ! ( cd "$ROOT" && git pull --ff-only --quiet origin main 2>/dev/null ); then
      echo -e "${YELLOW}⚠${RESET} Could not fast-forward (local changes?). Continuing with current tree."
    fi
    echo ""
    echo -e "  ${BOLD}What's new${RESET}"
    ( cd "$ROOT" && git log --oneline -8 2>/dev/null | sed 's/^/    · /' ) || true
    echo ""
  else
    echo -e "${YELLOW}⚠${RESET} Not a git checkout — rebuilding from the current tree."
  fi

  echo -e "${CYAN}→${RESET} Fetching dependencies…"
  ( cd "$ROOT" && mix deps.get 2>&1 | tail -3 ) || true
  echo -e "${CYAN}→${RESET} Compiling…"
  ( cd "$ROOT" && mix compile 2>&1 | tail -3 ) || true
  if [ -f "$TUI_DIR/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    echo -e "${CYAN}→${RESET} Rebuilding TUI…"
    ( cd "$TUI_DIR" && cargo build --release 2>&1 | grep -E "Compiling|Finished|error" | tail -3 ) || true
  fi

  new_ver="$(cat "$ROOT/VERSION" 2>/dev/null || echo "$old_ver")"
  echo ""
  if [ "$old_ver" = "$new_ver" ]; then
    echo -e "${GREEN}✓${RESET} Up to date ${DIM}(v${new_ver})${RESET}"
  else
    echo -e "${GREEN}✓${RESET} Updated ${DIM}v${old_ver}${RESET} → ${BOLD}v${new_ver}${RESET}"
  fi

  # Show the newest release-notes entry from the bundled CHANGELOG resource.
  print_release_notes

  # A fresh backend must pick up the new build.
  stop_daemon >/dev/null 2>&1 || true

  echo ""
  if [ -t 0 ]; then
    printf "  %bPress Enter to launch OSA…%b " "$DIM" "$RESET" >&2
    read -r _ || true
  fi
}

# Print the first version section of the bundled CHANGELOG (capped), so an
# updated user sees what's new without leaving the launcher.
print_release_notes() {
  local changelog="$ROOT/priv/CHANGELOG.md"
  [ -f "$changelog" ] || changelog="$ROOT/docs/operations/changelog.md"
  [ -f "$changelog" ] || return 0

  echo ""
  echo -e "  ${BOLD}What's new${RESET}"
  awk '
    /^## \[/ { hdr++; if (hdr > 1) exit }
    hdr >= 1 && shown < 24 { print "    " $0; shown++ }
  ' "$changelog" 2>/dev/null || true
}

# ── Version display padding ───────────────────────────────────────
# Pad the patch component to a minimum of 3 digits for DISPLAY only
# (1.0.1 -> 1.0.001, 1.0.17 -> 1.0.017, 1.0.128 -> 1.0.128). Major/minor and
# any -pre/+build suffix pass through untouched; a version that isn't a 3-part
# numeric core is returned unchanged. Mirrors the TUI's osa_version_display()
# so every surface reads the same padded form. Pure awk/printf — no network or
# destructive tooling involved.
pad_version() {
  printf '%s' "${1:-}" | awk '
    {
      v = $0; core = v; suffix = ""
      if (match(v, /[-+]/)) { core = substr(v, 1, RSTART - 1); suffix = substr(v, RSTART) }
      n = split(core, p, ".")
      if (n == 3 && p[1] ~ /^[0-9]+$/ && p[2] ~ /^[0-9]+$/ && p[3] ~ /^[0-9]+$/)
        printf "%s.%s.%03d%s\n", p[1], p[2], p[3] + 0, suffix
      else
        print v
    }'
}

# ── Subcommand pre-translation (verbs → TUI flags, then launch) ───
OVERDRIVE=0
case "${1:-}" in
  overdrive)
    OVERDRIVE=1; shift; set -- "$@" "--overdrive"
    ;;
  continue)
    shift; set -- "$@" "--continue"
    ;;
  resume)
    shift
    if [ -n "${1:-}" ] && [ "${1#-}" = "${1:-}" ]; then
      _rid="$1"; shift; set -- "$@" "--resume" "$_rid"
    else
      set -- "$@" "--resume"
    fi
    ;;
esac

# Any explicit full-auto flag also trips the warning.
for _a in "$@"; do
  case "$_a" in
    --overdrive|--dangerously-skip-permissions|--yolo) OVERDRIVE=1 ;;
  esac
done

# ── Subcommand dispatch ───────────────────────────────────────────
case "${1:-}" in
  version|--version|-v)
    # Display uses the padded patch (1.0.1 -> 1.0.001); the VERSION file itself
    # stays valid semver for mix/cargo.
    if [ -f "$ROOT/VERSION" ]; then
      echo "osagent v$(pad_version "$(cat "$ROOT/VERSION")")"
    else
      _v="$(cd "$ROOT" && mix run -e "IO.puts(Application.spec(:optimal_system_agent, :vsn))" 2>/dev/null)"
      if [ -n "$_v" ]; then
        echo "osagent v$(pad_version "$_v")"
      else
        echo "osagent (version unknown)"
      fi
    fi
    exit 0
    ;;

  setup)
    echo -e "${CYAN}→${RESET} Running setup wizard..."
    (cd "$ROOT" && mix osa.setup.wizard)
    exit $?
    ;;

  stop)
    stop_daemon
    exit 0
    ;;

  update)
    shift || true
    do_update_source
    # fall through to the default launch
    ;;

  serve)
    echo -e "${CYAN}→${RESET} Starting backend (foreground)..."
    (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
    (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
    (cd "$ROOT" && mix deps.get --quiet 2>&1 | tail -3)
    (cd "$ROOT" && mix osa.serve)
    exit 0
    ;;

  doctor)
    (cd "$ROOT" && mix run --no-start -e "OptimalSystemAgent.CLI.Doctor.run()" 2>/dev/null) || \
      echo "Doctor command not available. Try: osa then type /doctor"
    exit 0
    ;;

  opencomputers)
    shift
    (cd "$ROOT" && mix run --no-start -e "OptimalSystemAgent.CLI.opencomputers(System.argv())" -- "$@")
    exit $?
    ;;

  help|--help|-h)
    print_help
    exit 0
    ;;
esac

# ── Default: warm the daemon, then launch the TUI ────────────────

detect_pkg

# ── Auto-install missing dependencies (first run on a source checkout) ──

# Install native build deps for Rust TUI on Linux
install_linux_build_deps() {
  [ "$(uname -s)" = "Linux" ] || return 0
  [ -f "$TUI_BIN" ] && return 0

  echo -e "${CYAN}→${RESET} Checking build dependencies..."
  case "$PKG" in
    apt)
      local needed=()
      command -v pkg-config >/dev/null 2>&1 || needed+=(pkg-config)
      command -v gcc >/dev/null 2>&1        || needed+=(build-essential)
      [ -f /usr/lib/*/libssl.so ] 2>/dev/null || [ -f /usr/lib/*/libssl.a ] 2>/dev/null || needed+=(libssl-dev)
      [ -f /usr/lib/*/libxcb.so ] 2>/dev/null || [ -f /usr/lib/*/libxcb.a ] 2>/dev/null || needed+=(libxcb1-dev libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev)
      [ -f /usr/lib/*/libasound.so ] 2>/dev/null || [ -f /usr/lib/*/libasound.a ] 2>/dev/null || needed+=(libasound2-dev)
      [ -f /usr/lib/*/libonig.so ] 2>/dev/null || [ -f /usr/lib/*/libonig.a ] 2>/dev/null || needed+=(libonig-dev)
      if [ ${#needed[@]} -gt 0 ]; then
        echo -e "${CYAN}→${RESET} Installing: ${needed[*]}..."
        $SUDO apt-get update -qq 2>/dev/null || true
        $SUDO apt-get install -y -qq "${needed[@]}" 2>/dev/null || true
      fi
      ;;
    dnf|yum)
      pkg_install gcc gcc-c++ make pkg-config openssl-devel libxcb-devel alsa-lib-devel oniguruma-devel 2>/dev/null || true
      ;;
    pacman)
      pkg_install base-devel pkg-config openssl libxcb alsa-lib oniguruma 2>/dev/null || true
      ;;
    apk)
      pkg_install build-base pkgconfig openssl-dev libxcb-dev alsa-lib-dev oniguruma-dev 2>/dev/null || true
      ;;
    zypper)
      pkg_install gcc gcc-c++ make pkg-config libopenssl-devel libxcb-devel alsa-devel oniguruma-devel 2>/dev/null || true
      ;;
  esac
}

# Auto-install Rust if missing
if ! command -v cargo >/dev/null 2>&1; then
  echo -e "${CYAN}→${RESET} Rust not found — installing automatically..."
  if command -v curl >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --quiet
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://sh.rustup.rs | sh -s -- -y --quiet
  else
    echo -e "${RED}✗ Neither curl nor wget found.${RESET}"
    echo -e "${DIM}  Falling back to CLI mode.${RESET}"
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
  . "${HOME}/.cargo/env" 2>/dev/null || true
  export PATH="${HOME}/.cargo/bin:$PATH"
  if ! command -v cargo >/dev/null 2>&1; then
    echo -e "${RED}✗ Rust installation failed.${RESET} Install manually: https://rustup.rs"
    echo -e "${DIM}  Falling back to CLI mode.${RESET}"
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
  echo -e "${GREEN}✓${RESET} Rust installed"
fi

# Auto-install Elixir if missing or too old
install_elixir_prebuilt() {
  local elixir_ver="1.18.3"
  local otp_major
  otp_major=$(erl -eval 'io:format("~s", [erlang:system_info(otp_release)]), halt().' -noshell 2>/dev/null || echo "27")
  local url="https://github.com/elixir-lang/elixir/releases/download/v${elixir_ver}/elixir-otp-${otp_major}.zip"
  echo -e "${CYAN}→${RESET} Installing Elixir ${elixir_ver} from prebuilt..."
  local dest="/usr/local/lib/elixir"
  $SUDO mkdir -p "$dest"
  command -v unzip >/dev/null 2>&1 || pkg_install unzip 2>/dev/null || true
  if curl -fsSLo /tmp/elixir.zip "$url" 2>/dev/null; then
    $SUDO unzip -qo /tmp/elixir.zip -d "$dest"
    rm -f /tmp/elixir.zip
    for bin in elixir mix iex elixirc; do
      $SUDO ln -sf "$dest/bin/$bin" /usr/local/bin/"$bin"
    done
    echo -e "${GREEN}✓${RESET} Elixir ${elixir_ver} installed"
  else
    echo -e "${RED}✗ Could not download Elixir prebuilt.${RESET}"
    return 1
  fi
}

if ! command -v mix >/dev/null 2>&1; then
  echo -e "${CYAN}→${RESET} Elixir not found — installing automatically..."
  case "$(uname -s)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        echo -e "${CYAN}→${RESET} Installing Homebrew first..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ -f "/opt/homebrew/bin/brew" ]; then
          eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f "/usr/local/bin/brew" ]; then
          eval "$(/usr/local/bin/brew shellenv)"
        fi
      fi
      brew install erlang elixir
      ;;
    Linux)
      case "$PKG" in
        apt) $SUDO apt-get update -qq; pkg_install erlang 2>/dev/null || true ;;
        dnf|yum) pkg_install epel-release 2>/dev/null || true; pkg_install erlang 2>/dev/null || true ;;
        pacman) pkg_install erlang 2>/dev/null || true ;;
        apk) pkg_install erlang 2>/dev/null || true ;;
        zypper) pkg_install erlang 2>/dev/null || true ;;
      esac
      pkg_install elixir 2>/dev/null || true
      if ! command -v mix >/dev/null 2>&1 || ! check_elixir_version; then
        install_elixir_prebuilt || {
          echo -e "${RED}✗ Cannot install Elixir.${RESET}"
          exit 1
        }
      fi
      ;;
  esac
  if ! command -v mix >/dev/null 2>&1; then
    echo -e "${RED}✗ Elixir installation failed.${RESET}"
    exit 1
  fi
  echo -e "${GREEN}✓${RESET} Elixir ready"
  echo -e "${CYAN}→${RESET} Fetching dependencies..."
  (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix deps.get 2>&1 | tail -5)
  (cd "$ROOT" && mix compile 2>&1 | tail -5)
elif ! check_elixir_version; then
  echo -e "${YELLOW}⚠${RESET} Elixir version too old (need 1.17+). Upgrading..."
  install_elixir_prebuilt || echo -e "${RED}✗ Could not upgrade Elixir.${RESET}"
fi

# Install Linux build deps before Rust build
install_linux_build_deps

# Build Rust TUI if needed
if [ ! -f "$TUI_BIN" ]; then
  if [ -f "$TUI_DIR/Cargo.toml" ]; then
    echo -e "${CYAN}→${RESET} Building TUI (first run, ~60s)..."
    (cd "$TUI_DIR" && cargo build --release 2>&1 | tail -10)
    if [ ! -f "$TUI_BIN" ]; then
      echo -e "${RED}✗ TUI build failed.${RESET} Falling back to CLI mode."
      echo -e "${DIM}  Check: cargo, rustc installed? Run: rustup update${RESET}"
      (cd "$ROOT" && mix osa.chat)
      exit $?
    fi
  else
    echo -e "${RED}✗ TUI source not found.${RESET} Falling back to CLI mode."
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
fi

# Ensure Elixir deps are compiled
if [ ! -d "$ROOT/_build" ]; then
  echo -e "${CYAN}→${RESET} First-time compile..."
  (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix deps.get 2>&1 | tail -5)
  (cd "$ROOT" && mix compile 2>&1 | tail -5)
fi

# Auto-enable computer_use on Linux X11
if [ "$(uname -s)" = "Linux" ] && [ -n "${DISPLAY:-}" ]; then
  export OSA_COMPUTER_USE="${OSA_COMPUTER_USE:-true}"
fi

# Build the TUI arg list (strip --dev, which is a launcher-only concern).
TUI_ARGS=()
for arg in "$@"; do
  [ "$arg" = "--dev" ] && continue
  TUI_ARGS+=("$arg")
done

# ── Warm the backend daemon (attach instantly if already healthy) ──
if backend_healthy; then
  echo -e "${DIM}Backend already running on :${PORT} — attaching.${RESET}"
else
  clear_stale_pid
  start_daemon
  rc=0
  wait_health 90 || rc=$?
  if [ "${rc:-0}" -eq 2 ]; then
    echo -e "${RED}✗ Backend exited during startup.${RESET}"
    if command -v lsof >/dev/null 2>&1 && lsof -i ":${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
      echo -e "  ${DIM}Port ${PORT} is already in use. Try:${RESET} ${CYAN}OSA_PORT=<n> osa${RESET} ${DIM}or${RESET} ${CYAN}osa stop${RESET}"
    fi
    echo "  Last log lines:"
    tail -15 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
    rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    exit 1
  elif [ "${rc:-0}" -eq 1 ]; then
    echo -e "${RED}✗ Backend did not become healthy on :${PORT} in time.${RESET}"
    echo "  Last log lines:"
    tail -15 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
    exit 1
  fi
  echo -e "${DIM}Backend ready. It stays warm in the background — ${RESET}${CYAN}osa stop${RESET}${DIM} to shut it down.${RESET}"
fi

# First-run: if no ~/.osa/.env exists, run the setup wizard
if [ ! -f "$OSA_HOME/.env" ]; then
  echo -e "${CYAN}→${RESET} First-time setup..."
  (cd "$ROOT" && mix osa.setup.wizard) || \
    echo -e "${YELLOW}⚠${RESET} Setup skipped. Run 'osa setup' later to configure."
fi

# Show the overdrive warning right before handing off to the TUI.
[ "$OVERDRIVE" -eq 1 ] && warn_overdrive

# Launch the TUI. The backend daemon deliberately outlives this process.
export OSA_URL="http://localhost:${PORT}"
exec "$TUI_BIN" ${TUI_ARGS[@]+"${TUI_ARGS[@]}"}

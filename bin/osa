  echo -e "    ${CYAN}--continue${RESET}                      Resume newest session here"
  echo -e "    ${CYAN}--resume${RESET} ${DIM}[id]${RESET}                 Resume a session"
  echo -e "    ${CYAN}--permission-mode${RESET} ${DIM}<mode>${RESET}      ask · auto-edit · plan · overdrive"
  echo -e "    ${CYAN}--dev${RESET}                           Dev profile ${DIM}(port 19001)${RESET}"
  echo -e "    ${CYAN}--settings${RESET} ${DIM}<file>${RESET}               Extra settings file ${DIM}(highest-priority file layer)${RESET}"
  echo ""

#!/usr/bin/env bash
# bin/osa — the one command to run OSA (source checkout).
#
# `osa` is seamless: no separate backend to babysit, no bin/ to remember.
# The first `osa` warms a background ERTS backend (a daemon that survives TUI
# exit), then drops you into the TUI. Every `osa` after that attaches instantly.
#
# Commands:
#   osa                    Attach the TUI (warms the backend daemon if needed)
#   osa overdrive          Launch in overdrive (full auto) — no approval prompts
#   osa continue           Resume the newest session in this directory
#   osa resume [id]        Resume a specific session (or pick one)
#   osa stop               Stop the background backend daemon
#   osa setup              Run the setup wizard
#   osa update             Update in place (your local edits are preserved:
#                          stashed → rebased onto latest → reapplied), then launch
#   osa update --discard-local
#                          Update to a pristine tree; local changes are set aside
#                          in a named stash and NOT reapplied (asks to confirm)
#   osa update --staged    Rollback-safe update: stage+build+boot-probe, then
#                          atomic-swap $OSA_HOME/current (see bin/osa-update)
#   osa update --rollback  Swap $OSA_HOME/current back to the previous version
#   osa update --dry-run   Print the staged-update plan; change nothing
#   osa doctor             Run backend health checks
#   osa auth               Show account sign-ins (status/login/logout)
#   osa usage [all]        Account quota + this session's token usage
#   osa logout [provider]  Sign out of a provider account
#   osa serve              Run the backend in the foreground (headless API)
#   osa version            Print version
#   osa help               Show this help
#
# Flags (passed through to the TUI):
#   --overdrive                        Full-auto mode (same as `osa overdrive`)
#   --dangerously-skip-permissions     Silent alias for --overdrive
#   --continue                         Resume newest session here
#   --resume [id]                      Resume a session
#   --permission-mode <mode>           ask | auto-edit | plan | overdrive
#   --dev                              Dev profile (port 19001)
#   --settings <file>                  Extra settings file (highest-priority file layer)
#
# Multiple Instances:
#   Running `osa` in different directories automatically isolates each one
#   into its own backend daemon (separate port, state dir, memory, sessions).
#   Same directory = attach to the existing daemon. Different directory = new
#   daemon on the next free port. Set OSA_PORT or OSA_HOME to override.

set -euo pipefail

# ── Safe defaults ────────────────────────────────────────────────
HOME="${HOME:-/root}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

# ── BEAM scheduler busy-wait: off (issue #66) ─────────────────────
# Mirrors rel/env.sh.eex for the source-tree launcher, which starts the daemon
# with `mix osa.serve` and so never runs the release's env.sh. The BEAM's
# schedulers, dirty-CPU and dirty-IO schedulers spin looking for work before
# they park; that is right for a dedicated server and wrong for a warm
# background daemon on a laptop that spends nearly all of its wall-clock
# waiting on a model. Left as-is it can burn close to one core per scheduler
# thread for as long as OSA is installed.
#
# Set OSA_BEAM_BUSY_WAIT=1 to keep the stock OTP behaviour; an ERL_FLAGS that
# already mentions +sbwt is left completely alone.
if [ -z "${OSA_BEAM_BUSY_WAIT:-}" ]; then
  case "${ERL_FLAGS:-}" in
    *+sbwt*) ;;
    *) ERL_FLAGS="${ERL_FLAGS:+${ERL_FLAGS} }+sbwt none +sbwtdcpu none +sbwtdio none" ;;
  esac
  export ERL_FLAGS
fi

# Capture the user's launch directory BEFORE any `cd` below, and hand it to the
# backend as OSA_ORIGINAL_CWD. The daemon starts with `cd "$ROOT"` (the OSA
# source tree) then `mix osa.serve`, so without this the backend's File.cwd!()
# resolves to the OSA source dir — making the workspace identity (and the TUI
# status bar) read "OptimalSystemAgent" instead of the project you launched in.
export OSA_ORIGINAL_CWD="${OSA_ORIGINAL_CWD:-$PWD}"

# sudo helper: skip when already root
if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
else
  SUDO="sudo"
fi

# ── Colors (OSA blue identity) ───────────────────────────────────
if [ -t 1 ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  RED='\033[0;31m'
  CYAN='\033[0;36m'
  BLUE='\033[0;34m'
  RESET='\033[0m'
else
  BOLD='' DIM='' GREEN='' YELLOW='' RED='' CYAN='' BLUE='' RESET=''
fi

# ── Detect package manager ───────────────────────────────────────
detect_pkg() {
  if   command -v apt-get >/dev/null 2>&1; then PKG="apt"
  elif command -v dnf     >/dev/null 2>&1; then PKG="dnf"
  elif command -v pacman  >/dev/null 2>&1; then PKG="pacman"
  elif command -v apk     >/dev/null 2>&1; then PKG="apk"
  elif command -v zypper  >/dev/null 2>&1; then PKG="zypper"
  elif command -v yum     >/dev/null 2>&1; then PKG="yum"
  elif command -v brew    >/dev/null 2>&1; then PKG="brew"
  else PKG="unknown"
  fi
}

# Package install abstraction
pkg_install() {
  case "$PKG" in
    apt)    $SUDO apt-get install -y -qq "$@" ;;
    dnf)    $SUDO dnf install -y -q "$@" ;;
    yum)    $SUDO yum install -y -q "$@" ;;
    pacman) $SUDO pacman -Sy --noconfirm "$@" ;;
    apk)    $SUDO apk add --no-cache "$@" ;;
    zypper) $SUDO zypper install -y "$@" ;;
    brew)   brew install "$@" ;;
    *)      return 1 ;;
  esac
}

# ── HTTP helper (curl → wget fallback) ───────────────────────────
_http_ok() {
  if command -v curl >/dev/null 2>&1; then
    curl -sf "$1" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO /dev/null "$1" 2>/dev/null
  else
    return 1
  fi
}

# True when any TCP listener owns a local port, whether it is OSA or another
# process. Auto-isolation must skip foreign listeners too; probing only OSA's
# /health endpoint mistakes them for free ports and selects a guaranteed bind
# failure. Bash's /dev/tcp keeps this dependency-free when lsof is unavailable.
_port_in_use() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti ":$1" -sTCP:LISTEN >/dev/null 2>&1
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
  fi
}

# ── Daemon ownership: whose backend is that, really? ─────────────
#
# Auto-isolation (below) keys a workspace off a hash of the launch directory
# and remembers the port it chose in that workspace's own backend.port. But a
# FILE outlives the process it describes: a daemon that dies without cleaning
# up leaves a port NUMBER behind, and the OS is free to hand that number to the
# next process that asks for one — including another workspace's OSA daemon.
#
# "Something healthy answers on that port" is therefore not evidence that the
# something is ours. It used to be the entire test, which is how one folder
# could attach to a different folder's backend and `osa stop` could kill it.
# So ownership is asked of the daemon itself: /health reports `workspace`, the
# OSA_ORIGINAL_CWD it was started with — the exact string this script exported
# when it launched that daemon — and adoption requires it to equal ours.

# The launch directory a daemon claims, or empty when it does not answer or
# does not report one (any daemon older than this field). Never fails the
# caller: "it did not say" is an answer the callers below handle explicitly.
_daemon_workspace() {
  local body=""
  if command -v curl >/dev/null 2>&1; then
    body="$(curl -sf --max-time 3 "http://localhost:${1}/health" 2>/dev/null || true)"
  elif command -v wget >/dev/null 2>&1; then
    body="$(wget -qO- --timeout=3 "http://localhost:${1}/health" 2>/dev/null || true)"
  fi
  [ -n "$body" ] || return 0
  printf '%s' "$body" \
    | sed -n 's/.*"workspace"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# Same directory? Both sides are absolute (the daemon reports a Path.expand'ed
# string, ours is $PWD), so this only has to absorb a trailing slash. Two empty
# paths are NOT "the same" — an unknown workspace must never match ours.
_same_dir() {
  local a="${1:-}" b="${2:-}"
  [ -n "$a" ] && [ -n "$b" ] && [ "${a%/}" = "${b%/}" ]
}

# Version-independent ownership proof, for daemons too old to report a
# workspace: is the PID this workspace recorded for its OWN daemon the process
# currently listening on that port? Deliberately positive-only — a "no" does
# not mean the daemon is foreign, only that we cannot prove it is ours, which
# is exactly how the caller treats it. False positives would need a recycled
# PID to also hold that listener; false negatives just cost a second daemon.
_pidfile_owns_port() {
  local pid owner
  command -v lsof >/dev/null 2>&1 || return 1
  [ -f "$1" ] || return 1
  pid="$(cat "$1" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  for owner in $(lsof -ti ":${2}" -sTCP:LISTEN 2>/dev/null || true); do
    if [ "$owner" = "$pid" ]; then return 0; fi
  done
  return 1
}

# Elixir version check (>= 1.17)
check_elixir_version() {
  local ver major minor
  ver=$(elixir --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  [ -z "$ver" ] && return 1
  major=$(echo "$ver" | cut -d. -f1)
  minor=$(echo "$ver" | cut -d. -f2)
  [ "${major:-0}" -gt 1 ] && return 0
  [ "${major:-0}" -eq 1 ] && [ "${minor:-0}" -ge 17 ] && return 0
  return 1
}

# ── Resolve project root ──────────────────────────────────────────
SCRIPT="$0"
if [ -L "$SCRIPT" ]; then
  SCRIPT="$(readlink -f "$SCRIPT" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$SCRIPT" 2>/dev/null || perl -e 'use Cwd "abs_path"; print abs_path(shift)' "$SCRIPT")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"

# OSA_HOME only depends on $HOME, so resolve it before ROOT: a staged,
# rollback-safe update (see `osa update`, bin/osa-update) repoints
# $OSA_HOME/current at a new build via an atomic symlink swap, and — when
# present — that symlink is what `osa` follows on every subsequent launch.
OSA_HOME="${OSA_HOME:-${HOME}/.osa}"

# m9 fix: "is onboarding done" must be the SAME check the app uses
# (Onboarding.first_run?/0, lib/optimal_system_agent/onboarding.ex ~L53-61):
# ~/.osa/.env exists AND has an uncommented OSA_DEFAULT_PROVIDER= line. The
# old gate here only checked file *existence*, so an .env with no provider
# line (e.g. only channel tokens, or a partially-written file from an
# interrupted wizard run) made bin/osa SKIP the wizard while the app still
# reports first_run? == true — the wizard re-triggers on every subsequent
# `osa` invocation, an infinite onboarding loop.
env_has_provider() {
  local env_file="$1"
  [ -f "$env_file" ] || return 1
  grep -qE '^[^#]*OSA_DEFAULT_PROVIDER=' "$env_file" 2>/dev/null
}

# Direct invocation of a source checkout (`./bin/osa` from a dev tree, or an
# entrypoint symlink resolved via readlink -f to such a tree) always wins: a
# developer iterating on their own checkout must never be silently redirected
# elsewhere. Next preference is a staged/managed install that has completed at
# least one `osa update` ($OSA_HOME/current, kept in sync by bin/osa-update).
# Last is the legacy project_root file written by the source installer.
if [ -f "$SCRIPT_DIR/../mix.exs" ]; then
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -L "$OSA_HOME/current" ] && [ -f "$OSA_HOME/current/mix.exs" ]; then
  ROOT="$OSA_HOME/current"
elif [ -f "${HOME}/.osa/project_root" ]; then
  ROOT="$(cat "${HOME}/.osa/project_root")"
else
  echo -e "${RED}Error: Cannot find OSA project root.${RESET}"
  echo "Run the installer: curl -fsSL https://raw.githubusercontent.com/Miosa-osa/OSA/main/scripts/install.sh | sh"
  exit 1
fi

TUI_DIR="$ROOT/priv/rust/tui"
TUI_BIN="$TUI_DIR/target/release/osagent"

# ── Resolve backend port (honor --dev anywhere in args) ──────────
# OSA_PORT is the launcher's historical knob; OSA_HTTP_PORT is the backend's.
# Accept either one, then export both below so the launcher, TUI, and BEAM can
# never observe different ports.
_EXPLICIT_PORT="${OSA_PORT:-${OSA_HTTP_PORT:-}}"
PORT="${_EXPLICIT_PORT:-9089}"
for _a in "$@"; do
  [ "$_a" = "--dev" ] && PORT="${_EXPLICIT_PORT:-19001}"
done

# ── Auto-isolation by working directory ──────────────────────────
#
# Like `claude` — run `osa` anywhere and it just works. Same cwd = attach to
# the existing daemon. Different cwd = spin up a new daemon on the next free
# port with its own state dir. Zero extra commands.
#
# Skip entirely when the user explicitly sets either port name or OSA_HOME (the power-
# user escape hatch). `--dev` also bypasses: the dev profile is a single
# fixed instance on 19001.
_OSA_AUTO_WS=0
if [ -z "$_EXPLICIT_PORT" ] && [ "${OSA_HOME:-${HOME}/.osa}" = "${HOME}/.osa" ]; then
  _dev_flag=0
  for _a in "$@"; do [ "$_a" = "--dev" ] && _dev_flag=1; done
  if [ "$_dev_flag" -eq 0 ]; then
    # Auto-isolation is live for this run. Recorded so the stop path knows it
    # is dealing with a port this script CHOSE, not one the operator named.
    _OSA_AUTO_WS=1

    # Hash the working directory into a short, stable slug.
    _ws_hash=$(printf '%s' "$OSA_ORIGINAL_CWD" | shasum -a 256 | cut -c1-12)
    _ws_home="${HOME}/.osa/workspaces/${_ws_hash}"
    _ws_port_file="${_ws_home}/run/backend.port"

    # Does this workspace already have a daemon? Its port file names a port —
    # but the port file outlives the daemon, so a healthy answer there is not
    # proof of ownership (see _daemon_workspace above). Ask who it belongs to.
    if [ -f "$_ws_port_file" ]; then
      _ws_port="$(cat "$_ws_port_file" 2>/dev/null || true)"
      if [ -n "$_ws_port" ] && _http_ok "http://localhost:${_ws_port}/health" 2>/dev/null; then
        _ws_owner="$(_daemon_workspace "$_ws_port")"
        if _same_dir "$_ws_owner" "$OSA_ORIGINAL_CWD"; then
          # It says it is ours, and it is.
          PORT="$_ws_port"
          OSA_HOME="$_ws_home"
        elif [ -z "$_ws_owner" ] && _pidfile_owns_port "${_ws_home}/run/backend.pid" "$_ws_port"; then
          # It predates the `workspace` field, so it cannot identify itself —
          # and refusing every such daemon would orphan the warm backend of
          # every user upgrading past this version, leaving it running on a
          # port nobody adopts again. Adopt it only on independent proof: the
          # PID we recorded for THIS workspace is the one holding that listener.
          # The skew repair further down then restarts it onto the new build.
          PORT="$_ws_port"
          OSA_HOME="$_ws_home"
        elif [ -n "$_ws_owner" ]; then
          # It answered, and named someone else's folder. Say so once — this is
          # the case that used to silently hijack another workspace's backend.
          echo -e "${DIM}:${_ws_port} now belongs to ${_ws_owner} — starting a separate backend for this folder.${RESET}" >&2
        fi
      fi
    fi

    # No healthy daemon for this workspace yet — find the next free port.
    if [ "${OSA_HOME:-${HOME}/.osa}" = "${HOME}/.osa" ]; then
      mkdir -p "$_ws_home/run" "$_ws_home/logs"
      _candidate=9089
      if _port_in_use "${_candidate}"; then
        _candidate=9090
        while _port_in_use "${_candidate}"; do
          _candidate=$((_candidate + 1))
        done
      fi
      PORT="$_candidate"
      OSA_HOME="$_ws_home"
    fi
  fi
fi
export OSA_HOME
export OSA_PORT="$PORT"
export OSA_HTTP_PORT="$PORT"

# ── Inherit global credentials into fresh workspaces ─────────────
# When isolation routes us into a per-cwd workspace dir, that dir is empty on
# first launch. The setup-complete gate (env_has_provider "$OSA_HOME/.env")
# would then fire the wizard every time you launch osa in a new directory —
# even though the operator already set up ~/.osa/.env once, globally.
# Seed a symlink so the workspace inherits global credentials automatically.
# Users who want per-workspace credentials just replace the symlink with a
# real file.
if [ "$OSA_HOME" != "${HOME}/.osa" ] && [ -f "${HOME}/.osa/.env" ] && [ ! -e "$OSA_HOME/.env" ]; then
  ln -s "${HOME}/.osa/.env" "$OSA_HOME/.env" 2>/dev/null || true
fi

# ── Derived paths (computed AFTER isolation may reassign OSA_HOME) ─
# PID_FILE / PORT_FILE / LOG_FILE must live under the finalized OSA_HOME
# so start_daemon writes and stop_daemon reads the same files.
LOG_DIR="$OSA_HOME/logs"
RUN_DIR="$OSA_HOME/run"
PID_FILE="$RUN_DIR/backend.pid"
PORT_FILE="$RUN_DIR/backend.port"
LOG_FILE="$LOG_DIR/backend.log"
mkdir -p "$LOG_DIR" "$RUN_DIR"

HEALTH_URL="http://localhost:${PORT}/health"

# ── --settings <file>: extra highest-priority settings file layer ─
# Consumed here (NOT forwarded to the TUI) and exported as OSA_SETTINGS so the
# backend reads it as the flag layer of the cascade. Note: only a FRESHLY
# started daemon inherits it — an already-warm daemon keeps its environment.
_OSA_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --settings)
      shift
      if [ -n "${1:-}" ]; then
        OSA_SETTINGS="$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" || OSA_SETTINGS="$1"
        export OSA_SETTINGS
        shift
      fi
      ;;
    --settings=*)
      _osa_sfile="${1#--settings=}"
      OSA_SETTINGS="$(cd "$(dirname "$_osa_sfile")" 2>/dev/null && pwd)/$(basename "$_osa_sfile")" || OSA_SETTINGS="$_osa_sfile"
      export OSA_SETTINGS
      shift
      ;;
    *)
      _OSA_ARGS+=("$1")
      shift
      ;;
  esac
done
set -- ${_OSA_ARGS[@]+"${_OSA_ARGS[@]}"}

# ── Daemon helpers ────────────────────────────────────────────────
backend_healthy() { _http_ok "$HEALTH_URL"; }

# ── Disk vs RAM version skew ────────────────────────────────────────────────
# `osa update` rebuilds the tree on DISK, but a backend daemon started before
# the update keeps serving the OLD code from MEMORY. The launch path attaches
# to whatever is already listening on :$PORT, and the TUI renders whatever
# /health reports — so the user sees the old version and concludes the release
# never shipped. The daemon's own /health version is therefore the only
# trustworthy answer to "did the update actually take effect?".

# Version reported by the LIVE daemon (empty if none / unreadable).
_daemon_version() {
  local body=""
  if command -v curl >/dev/null 2>&1; then
    body="$(curl -sf --max-time 3 "$HEALTH_URL" 2>/dev/null || true)"
  elif command -v wget >/dev/null 2>&1; then
    body="$(wget -qO- --timeout=3 "$HEALTH_URL" 2>/dev/null || true)"
  fi
  [ -n "$body" ] || return 1
  printf '%s' "$body" \
    | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# Version of the checkout on disk.
_tree_version() { cat "$ROOT/VERSION" 2>/dev/null || true; }

# Version baked into the built TUI binary (empty if missing/unrunnable).
_tui_binary_version() {
  [ -x "$TUI_BIN" ] || return 1
  "$TUI_BIN" --version 2>/dev/null | head -1 | awk '{print $NF}'
}

# 0 = live daemon matches the tree (or there is nothing to compare), 1 = skew.
_daemon_matches_tree() {
  local running tree
  tree="$(_tree_version)"
  [ -n "$tree" ] || return 0
  backend_healthy || return 0
  running="$(_daemon_version || true)"
  [ -n "$running" ] || return 0
  [ "$(_norm_version "$running")" = "$(_norm_version "$tree")" ]
}

# Loud report of a stale backend the user must resolve themselves. Since the
# launch path now REPAIRS skew automatically (_ensure_fresh_daemon below), this
# is reached only in the one case where repairing would destroy someone's work:
# the daemon is genuinely busy and we could not ask (non-interactive).
_warn_stale_daemon() {
  local running tree
  tree="$(_tree_version)"
  running="$(_daemon_version || true)"
  echo -e "${YELLOW}⚠${RESET} ${BOLD}A stale OSA backend is running on :${PORT}.${RESET}" >&2
  echo -e "    ${DIM}on disk:${RESET} v${tree}" >&2
  echo -e "    ${DIM}running:${RESET} v${running:-<unreadable>}  ${DIM}← this is what the TUI will display${RESET}" >&2
  echo -e "  ${DIM}That daemon started before the current build, so it still serves the OLD code.${RESET}" >&2
  echo -e "  ${DIM}It was left alone because it is busy; it will be refreshed automatically once idle.${RESET}" >&2
}

# ── Is the running backend in the middle of something? ──────────────────────
#
# Restarting drops warm state and kills whatever the daemon is doing, so the
# auto-repair below needs an "is anyone relying on this process right now?"
# answer. Crucially it CANNOT come from /health: the daemon we are judging is by
# definition running OLD code, so any field added here would be missing on
# exactly the daemons that need judging. Both signals below are therefore
# observed from OUTSIDE the daemon and work against any version, past or future.
#
# Echoes a human reason and returns 0 when busy; returns 1 when idle.
_daemon_busy_reason() {
  # (1) Another OSA TUI is attached. Work in OSA is driven through a session, so
  # a live TUI means a real user is mid-conversation with this exact daemon.
  # Matched on the FULL binary path, so an unrelated `osagent` elsewhere on the
  # box (e.g. a prebuilt install's own binary) is not mistaken for ours.
  if command -v pgrep >/dev/null 2>&1 && [ -x "$TUI_BIN" ]; then
    if pgrep -f "^${TUI_BIN}" >/dev/null 2>&1; then
      echo "another OSA session is attached to it"
      return 0
    fi
  fi
  # (2) The backend logged something in the last 15s — it is mid-turn even with
  # no TUI attached (a messaging channel or a headless run). An idle OSA backend
  # writes nothing at all, so recent output is a real activity signal and not a
  # heartbeat false-positive.
  if [ -f "$LOG_FILE" ]; then
    local mt now
    mt="$(stat -c %Y "$LOG_FILE" 2>/dev/null || stat -f %m "$LOG_FILE" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    if [ "${mt:-0}" -gt 0 ] && [ $((now - mt)) -lt 15 ]; then
      echo "it is still writing output (mid-turn)"
      return 0
    fi
  fi
  return 1
}

# ── Auto-repair disk/RAM skew on every launch ───────────────────────────────
#
# OSA's persistent backend is its own architectural cost: single-process agents
# (Claude Code, Codex) are new code the moment you relaunch them, while a warm
# OSA daemon happily outlives a rebuild and keeps serving the OLD version from
# memory. That cost is OSA's to absorb, not the user's — "run `osa stop` first"
# is not an instruction anyone should ever be given, and the word "daemon" is
# not one they should ever have to learn.
#
# So: skew is REPAIRED, not reported. This runs on the plain `osa` launch path,
# not just after `osa update`, because the skew is equally produced by a bare
# `mix compile` / `cargo build --release` or by another checkout having started
# the daemon earlier.
#
# Returns 0 when the caller may proceed (port freed, or deliberately left
# alone), 1 when the stale daemon refused to die — which is a hard error, since
# attaching anyway means silently running the wrong build.
_ensure_fresh_daemon() {
  if _daemon_matches_tree; then
    return 0
  fi

  local tree running busy=""
  tree="$(_tree_version)"
  running="$(_daemon_version || true)"

  if busy="$(_daemon_busy_reason)"; then
    # Restarting now would destroy work in flight. Ask if we can; if we cannot
    # ask, leave it running and say so loudly rather than killing it silently.
    if [ -t 0 ]; then
      echo -e "${YELLOW}⚠${RESET} The backend is running an older build ${DIM}(v${running:-?} → v${tree})${RESET}, but ${busy}."
      printf "  %bRestart it anyway? This ends that work. [y/N]%b " "$BOLD" "$RESET"
      local _reply=""
      read -r _reply || true
      case "$_reply" in
        y|Y|yes|YES) ;;
        *)
          echo -e "  ${DIM}Left it running — attaching to v${running:-?}.${RESET}"
          return 0
          ;;
      esac
    else
      _warn_stale_daemon
      return 0
    fi
  fi

  # The default path, and the one nearly every user gets: no question, no
  # instruction, one calm line.
  echo -e "${CYAN}→${RESET} Backend was running an older build — restarting…"
  if ! _stop_backend_confirmed quiet; then
    echo -e "${RED}✗${RESET} ${BOLD}The old backend on :${PORT} would not stop.${RESET}" >&2
    echo -e "  ${DIM}It reports v${running:-<unreadable>} but this checkout is v${tree}, so attaching${RESET}" >&2
    echo -e "  ${DIM}would silently run the OLD build. OSA will not do that.${RESET}" >&2
    echo -e "  ${DIM}Find what is holding :${PORT}: ${RESET}${CYAN}lsof -i :${PORT}${RESET}" >&2
    return 1
  fi
  clear_stale_pid
  return 0
}

daemon_pid() {
  # Echo the live daemon PID, or nothing. Prefers the pidfile, falls back to
  # whatever is listening on our port (covers daemons started out-of-band).
  local pid=""
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"; return 0
    fi
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti ":${PORT}" -sTCP:LISTEN 2>/dev/null | head -1
  fi
}

# Every PID holding a LISTEN socket on :$PORT, newline-separated, or nothing.
# Unlike `daemon_pid` this ignores the pidfile and ignores lineage: it answers
# "who would the next bind collide with", which is the only question the
# stop/restart path actually needs. Empty when lsof is unavailable.
_port_owners() {
  command -v lsof >/dev/null 2>&1 || return 0
  lsof -ti ":${PORT}" -sTCP:LISTEN 2>/dev/null || true
}

clear_stale_pid() {
  # Drop a pidfile whose process is gone and whose port is dead.
  if [ -f "$PID_FILE" ]; then
    local pid; pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    fi
  fi
}

stop_daemon() {
  local pid; pid="$(daemon_pid)"
  if [ -z "$pid" ]; then
    echo -e "${DIM}No OSA backend is running on :${PORT}.${RESET}"
    rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    return 0
  fi
  echo -e "${CYAN}→${RESET} Stopping OSA backend (pid ${pid})…"
  # Prefer a process-group kill (the daemon is a setsid group leader, so this
  # also reaps the BEAM/erl child that mix spawns); fall back to the bare pid.
  kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  local n=0
  while [ $n -lt 20 ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25; n=$((n + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
  echo -e "${GREEN}✓${RESET} Backend stopped."
}

# ── Last gate before anything gets killed ───────────────────────────────────
#
# Auto-isolation adopts a daemon only after it confirms the workspace, but that
# decision and this kill are separated by everything in between: our daemon can
# exit and another workspace's can take the port number in the gap. So the
# question is asked again, right here, against the process that is answering
# NOW. 0 = safe to stop, 1 = it belongs to someone else, leave it alone.
#
# Two deliberate exemptions, both "the operator named this target explicitly":
#
#   * $_OSA_AUTO_WS = 0 — OSA_PORT / OSA_HOME / --dev bypass isolation entirely.
#     Those are documented single-instance escape hatches; `osa stop --dev` must
#     keep stopping the dev daemon on :19001 no matter which folder it is run
#     from, which is precisely a cross-workspace stop, deliberately.
#   * A daemon that answers but reports no workspace (older than the field).
#     It is unidentifiable, not foreign, and refusing would leave `osa stop`
#     permanently unable to clean up after any pre-1.0.178 daemon. Silence is
#     permission here; the adoption path is where an unidentifiable daemon has
#     to earn its way in, and it does that against the pidfile instead.
_stop_target_is_ours() {
  local owner
  [ "${_OSA_AUTO_WS:-0}" = "1" ] || return 0
  owner="$(_daemon_workspace "$PORT")"
  [ -n "$owner" ] || return 0
  _same_dir "$owner" "$OSA_ORIGINAL_CWD" && return 0

  echo -e "${YELLOW}⚠${RESET} ${BOLD}Refusing to stop the backend on :${PORT} — it is not this folder's.${RESET}" >&2
  echo -e "    ${DIM}that daemon's folder:${RESET} ${owner}" >&2
  echo -e "    ${DIM}this folder:${RESET}         ${OSA_ORIGINAL_CWD}" >&2
  echo -e "  ${DIM}Stop it where it belongs:${RESET} ${CYAN}cd ${owner} && osa stop${RESET}" >&2
  return 1
}

# Stop the backend and POLL until :$PORT really stops answering.
#
# `stop_daemon` signals and waits on the PID, but the PID is not the contract —
# the PORT is: anything still listening on :$PORT is what the next launch (and
# the TUI) will attach to. A stop that "succeeded" while a socket lingers is the
# exact shape of the disk/RAM skew bug, so this is the single primitive both the
# update path and the launch path use. 0 = the port is free, 1 = it is not.
#
# Deliberately silent about WHY it is stopping: the callers own that message.
# Pass "quiet" to swallow stop_daemon's own pid/progress chatter — the launch
# path repairs skew as routine housekeeping and should read as one calm line,
# not as a three-line incident report about a process the user never asked about.
#
# Refuses outright when :$PORT is answering for a DIFFERENT workspace — see
# _stop_target_is_ours. Killing by port is the one irreversible act in this
# script, so ownership is re-checked here and not merely inherited from the
# adoption decision several hundred lines earlier.
_stop_backend_confirmed() {
  local n=0
  _stop_target_is_ours || return 1
  if [ "${1:-}" = "quiet" ]; then
    stop_daemon >/dev/null 2>&1 || true
  else
    stop_daemon || true
  fi
  while [ $n -lt 40 ]; do
    if ! backend_healthy; then break; fi
    sleep 0.25
    n=$((n + 1))
  done

  # Escalate to whatever still OWNS the socket. `stop_daemon` signals the
  # pidfile PID's process group, but the BEAM child does not always stay in
  # that group: `mix` can re-exec `beam.smp` into a group of its own, so the
  # launcher dies, the group kill finds nothing left to reap, and the BEAM
  # keeps :$PORT open. That is the "backend stopped / would not stop" pair
  # users see — both lines are true, they are just about different processes.
  # The PORT is the contract (see above), so reclaim it by port ownership
  # rather than by lineage. No-op when the port is already free.
  if command -v lsof >/dev/null 2>&1; then
    local sig
    for sig in TERM KILL; do
      [ -z "$(_port_owners)" ] && break
      # shellcheck disable=SC2086
      kill -"$sig" $(_port_owners) 2>/dev/null || true
      n=0
      while [ $n -lt 20 ] && [ -n "$(_port_owners)" ]; do
        sleep 0.25; n=$((n + 1))
      done
    done
    rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
  fi

  # Wait for the LISTEN socket itself to go, not just for /health to stop
  # answering. A shutting-down BEAM stops serving requests well before it
  # closes the listener, so a health-only check reports "stopped" while the
  # port is still bound — and the relaunch then dies with "Port 9089 is in
  # use by another process". The socket is the thing the next bind contends
  # for, so the socket is the thing we wait on.
  n=0
  while [ $n -lt 40 ] && [ -n "$(_port_owners)" ]; do
    sleep 0.25; n=$((n + 1))
  done

  [ -n "$(_port_owners)" ] && return 1
  if backend_healthy; then return 1; fi
  return 0
}

# Spinner while waiting for /health. Returns 0 healthy, 1 timeout, 2 died.
# Re-reads the pidfile each tick so daemon death is caught even before the
# child has finished writing its PID.
wait_health() {
  local max="${1:-90}"
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0 n=0 pid
  local ticks=$((max * 2))
  while [ $n -lt $ticks ]; do
    if backend_healthy; then
      [ -t 2 ] && printf '\r\033[K' >&2
      return 0
    fi
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      [ -t 2 ] && printf '\r\033[K' >&2
      return 2
    fi
    if [ -t 2 ]; then
      printf '\r  %b%s%b warming OSA backend…' "$CYAN" "${frames[$((i % 10))]}" "$RESET" >&2
      i=$((i + 1))
    fi
    sleep 0.5
    n=$((n + 1))
  done
  [ -t 2 ] && printf '\r\033[K' >&2
  return 1
}

# Start the backend as a detached warm daemon (survives TUI exit + terminal
# close). Records the real backend PID so `osa stop` can reach it.
start_daemon() {
  : > "$LOG_FILE"
  echo -e "${CYAN}→${RESET} Starting OSA backend on :${PORT} ${DIM}(background daemon)${RESET}"
  if command -v setsid >/dev/null 2>&1; then
    # The child writes its own PID (which `exec` preserves through to mix), so
    # the pidfile always points at the live backend regardless of setsid fork.
    setsid bash -c 'echo $$ > "'"$PID_FILE"'"; cd "'"$ROOT"'"; exec mix osa.serve' \
      >"$LOG_FILE" 2>&1 < /dev/null &
  else
    ( cd "$ROOT" && nohup mix osa.serve >"$LOG_FILE" 2>&1 < /dev/null & echo $! > "$PID_FILE" )
    disown 2>/dev/null || true
  fi
  echo "$PORT" > "$PORT_FILE"
}


# Red warning before entering overdrive (the TUI shows the one-time confirm).
warn_overdrive() {
  echo -e "${RED}${BOLD}  ⚠ OVERDRIVE (full auto)${RESET}${RED} — OSA will act without asking for approval.${RESET}" >&2
  echo -e "${DIM}    Only use this in a directory you trust. Confirm inside the TUI to proceed.${RESET}" >&2
}

# ── Update (source checkout, in place) ──────────────────────────────────────
#
# Contract, in one line: NEVER report success unless the tree really moved to
# the latest upstream commit, the rebuild really succeeded, and the built TUI
# really reports the version we just installed — and NEVER lose local work on
# the way there.
#
# The supported workflow is "I have my own edits in this checkout AND I want the
# latest OSA", so the default is preserve-and-integrate, not choose-one:
#
#   git fetch origin                (MUST succeed — otherwise we cannot know)
#     -> compare HEAD against the tracking branch, i.e. the REAL remote. The old
#        code compared the local VERSION file against itself, which is how
#        "Already up to date: v1.0.46" got printed on a tree that had never
#        moved and was two releases stale.
#     -> if the tree is dirty: git stash push -u -m osa-update-<timestamp>
#     -> git rebase <upstream>      (rebase, so local COMMITS survive too)
#     -> git stash apply, and only on success git stash drop
#     -> build (every step's exit status checked)
#     -> verify the freshly built TUI binary reports the new version
#
# Why an explicit NAMED stash instead of `git pull --rebase --autostash`:
# autostash creates an unnamed entry and drops it automatically, so on a
# conflict there is nothing recoverable we can name in the error message. A
# stash the user cannot find is the same as lost work. The named stash also
# survives every failure path here — nothing below ever drops it on error.
#
# Why `git stash push -u`: untracked files are the user's work too, and an
# incoming commit that adds a file at the same path aborts the rebase
# otherwise. `-u` does NOT touch .gitignore'd paths (that would be `-a`), so
# _build/, deps/ and priv/rust/tui/target/ are left alone. Note that `apply`
# restores everything as working-tree changes: the staged/unstaged split is not
# preserved, which is a deliberate trade for a much safer apply.
#
# Nothing here ever runs `git reset --hard`, `git checkout -f`, or `git stash
# drop` on a failure path. If the only way forward would destroy local work we
# stop and say so. `--discard-local` is the explicit, confirmed opt-out — and
# even that only stashes (it never deletes), so the work stays recoverable.
#
# NOT rollback-safe: if the rebased tree fails to compile this reports the
# failure loudly but leaves you on the new commit. For the rollback-safe path
# (stage in $OSA_HOME/versions/<rev>, build, boot-probe, then atomic symlink
# swap — see bin/osa-update) use `osa update --staged`.

# git wrapper pinned to the checkout being updated.
_ug() { git -C "$ROOT" "$@"; }

# Build the checkout. Every step is checked: the old version piped each command
# into `tail -3`, so `$?` was tail's and a hard compile failure was reported as
# a successful update. Returns non-zero and names a kept log on failure.
_update_build() {
  local log rc=0
  log="$(mktemp "${TMPDIR:-/tmp}/osa-update-build.XXXXXX")"
  echo -e "${CYAN}→${RESET} Building (this can take a minute)..."
  if ! ( cd "$ROOT" && mix deps.get && mix compile ) >"$log" 2>&1; then
    rc=1
  fi
  if [ "$rc" -eq 0 ] && [ -f "$TUI_DIR/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    if ! ( cd "$TUI_DIR" && cargo build --release ) >>"$log" 2>&1; then
      rc=1
    fi
  fi
  if [ "$rc" -ne 0 ]; then
    echo -e "${RED}✗${RESET} ${BOLD}Build failed${RESET} — OSA was NOT updated to a working state." >&2
    echo -e "  ${DIM}Last lines of the build log (${log}):${RESET}" >&2
    tail -n 25 "$log" >&2 2>/dev/null || true
    return 1
  fi
  rm -f "$log" 2>/dev/null || true
  return 0
}

# Does the freshly built TUI binary really report version $1? This is the check
# that separates "we rebuilt" from "we rebuilt NEW code" — the prebuilt updater
# in scripts/install.sh has done this since v1.0.46; the source path did not.
_update_verify_tui() {
  local want got
  want="$(_norm_version "${1:-}")"
  [ -n "$want" ] || return 0
  if [ ! -x "$TUI_BIN" ]; then
    echo -e "${RED}✗${RESET} TUI binary missing after the build (${TUI_BIN})." >&2
    echo -e "  ${DIM}Rebuild it with: ${RESET}${CYAN}(cd $TUI_DIR && cargo build --release)${RESET}" >&2
    return 1
  fi
  got="$(_norm_version "$("$TUI_BIN" --version 2>/dev/null | head -1 | awk '{print $NF}')")"
  if [ "$want" != "$got" ]; then
    echo -e "${RED}✗${RESET} TUI binary reports ${got:-<unreadable>} but the tree is v${1} — the build did not take." >&2
    echo -e "  ${DIM}Rebuild it with: ${RESET}${CYAN}(cd $TUI_DIR && cargo build --release)${RESET}" >&2
    return 1
  fi
  # Print the binary's own words, unmolested. The previous `v${...}` prepended a
  # "v" to a field that already carries one, so a healthy update signed off with
  # "reports vv1.0.49" — a cosmetic wart on the one line whose entire job is to
  # be believed. The failure branch above already prints the raw value; so does
  # the prebuilt launcher's equivalent line.
  echo -e "${GREEN}✓${RESET} Built TUI verified ${DIM}(reports $("$TUI_BIN" --version 2>/dev/null | head -1 | awk '{print $NF}'))${RESET}"
  return 0
}

# True when refs/stash still points at the entry we created (i.e. stash@{0} is
# ours). Guards every drop so a stash created by someone else is never dropped.
# Restart the backend after a SUCCESSFUL update. Stopping is NOT optional and
# NOT best-effort: the launch path below attaches to whatever is already
# listening on :$PORT, so a surviving old daemon means the user runs the new
# code's disk image and the old code's memory image — new binary, old behaviour,
# old version in the banner and status bar. Only ever called on the success
# path; a failed update never touches a running daemon.
#
# If the old process will not die we refuse to report the update as live.
_update_restart_backend() {
  local want="$1" running
  if ! backend_healthy && [ -z "$(daemon_pid)" ]; then
    return 0   # nothing running — the launch path will start the new build fresh
  fi
  echo -e "${CYAN}→${RESET} Restarting the backend so the new build is what actually runs..."
  if ! _stop_backend_confirmed; then
    running="$(_daemon_version || true)"
    echo -e "${RED}✗${RESET} ${BOLD}The old backend on :${PORT} would not stop.${RESET}" >&2
    echo -e "  ${DIM}The rebuild succeeded, but OSA would attach to that old process and show${RESET}" >&2
    echo -e "  ${DIM}v${running:-<unreadable>} instead of v${want}, so the update is NOT live and${RESET}" >&2
    echo -e "  ${DIM}OSA will not claim that it is.${RESET}" >&2
    echo -e "  ${DIM}Fix with: ${RESET}${CYAN}osa stop${RESET}${DIM} then ${RESET}${CYAN}osa${RESET}" >&2
    return 1
  fi
  echo -e "${GREEN}✓${RESET} Old backend stopped; the next launch starts v${want} fresh."
  return 0
}

_update_stash_is_top() {
  [ -n "${_osa_stash_commit:-}" ] || return 1
  [ "$(_ug rev-parse -q --verify refs/stash 2>/dev/null || true)" = "$_osa_stash_commit" ]
}

# How to get the saved work back. Printed on EVERY path that leaves a stash.
_update_print_stash_recovery() {
  local name="$1"
  echo "" >&2
  echo -e "  ${BOLD}Your local changes are saved and recoverable:${RESET}" >&2
  echo -e "    stash name: ${BOLD}${YELLOW}${name}${RESET}" >&2
  echo -e "    list it:    ${CYAN}git -C '$ROOT' stash list${RESET}" >&2
  echo -e "    restore it: ${CYAN}git -C '$ROOT' stash apply stash@{0}${RESET}" >&2
  echo -e "  ${DIM}Nothing was deleted. The stash is NOT dropped automatically.${RESET}" >&2
}

# ── The updater cannot update itself mid-run (and what we do about it) ──────
#
# `osa update` on a source checkout IS this script running `git pull`, and this
# script is one of the files that pull rewrites. Bash has already read the old
# text into memory, so the run that FETCHES a fixed updater still EXECUTES the
# old one. That is not a hypothetical: the v1.0.48 update pulled the commit that
# added the daemon restart and the exact-version release notes, then — in that
# same run — skipped the restart and printed `[Unreleased]`, because the code
# doing the work was the pre-fix code. Both bugs were already fixed on disk.
#
# The fix is to hand the rest of the update over to the script we just pulled.
#
# Fingerprint of every file that would change the update's BEHAVIOUR if pulled.
# Content hashes, not mtimes: a rebase rewrites mtimes on files whose bytes are
# identical, and re-exec'ing when nothing actually changed is its own bug.
_update_script_fingerprint() {
  local f h out=""
  for f in "$ROOT/bin/osa" "$ROOT/bin/osa-update"; do
    if [ ! -f "$f" ]; then
      out="${out}absent "
      continue
    fi
    if command -v sha256sum >/dev/null 2>&1; then
      h="$(sha256sum "$f" 2>/dev/null | awk '{print $1}')"
    elif command -v shasum >/dev/null 2>&1; then
      h="$(shasum -a 256 "$f" 2>/dev/null | awk '{print $1}')"
    else
      # cksum is POSIX and always present; CRC+size is ample for "did this
      # file's content change during OUR OWN pull, seconds ago".
      h="$(cksum "$f" 2>/dev/null | awk '{print $1 "-" $2}')"
    fi
    out="${out}${h:-unreadable} "
  done
  printf '%s' "$out"
}

# Hand the rest of the update to the freshly pulled script, if and only if that
# script actually changed. $1 = pre-pull fingerprint; the remaining arguments
# are the original `osa update` argv, replayed verbatim so --staged,
# --discard-local, --dev and anything else survive the boundary.
#
# Returns 0 to mean "carry on in THIS process" (nothing changed, or we are
# already the re-exec'd process). Returns 1 to mean "we should have handed over
# and could not" — a hard failure, never a silent fallback to the old logic,
# because silently continuing while pretending all is well is the entire family
# of bugs this change exists to kill.
_update_reexec_if_updater_changed() {
  local pre="$1"; shift
  local post new
  post="$(_update_script_fingerprint)"

  if [ "$pre" = "$post" ]; then
    return 0
  fi

  # ── Loop guard. The child is marked before exec and checks the mark here.
  # Even if the child somehow observes another change (a second pull, a
  # concurrent edit), it stops: an update that re-execs forever is far worse
  # than an update that finishes under one-generation-old logic, and we say so
  # out loud rather than hiding it.
  if [ -n "${OSA_UPDATE_REEXECED:-}" ]; then
    echo -e "${YELLOW}⚠${RESET} The updater changed again after the hand-off; continuing with the current one." >&2
    echo -e "  ${DIM}Re-executing a second time is refused by design (loop guard).${RESET}" >&2
    return 0
  fi

  new="$ROOT/bin/osa"
  if [ ! -f "$new" ] || [ ! -x "$new" ]; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} The pull replaced the updater, but ${new}" >&2
    echo -e "  ${DIM}is missing or not executable, so the rest of this update would run under the${RESET}" >&2
    echo -e "  ${DIM}OLD logic — which is exactly the bug being fixed. Refusing to continue.${RESET}" >&2
    echo -e "  ${DIM}Your tree is already on the new commit; finish with: ${RESET}${CYAN}chmod +x '$new' && osa update${RESET}" >&2
    return 1
  fi
  if ! bash -n "$new" 2>/dev/null; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} The pulled ${new} is not valid shell." >&2
    echo -e "  ${DIM}Refusing to hand off to a broken updater, and refusing to silently fall back${RESET}" >&2
    echo -e "  ${DIM}to the old one. Your tree is on the new commit; inspect with: ${RESET}${CYAN}bash -n '$new'${RESET}" >&2
    return 1
  fi

  echo -e "${CYAN}→${RESET} The updater itself changed — handing off to the new one ${DIM}(v$(cat "$ROOT/VERSION" 2>/dev/null || echo '?'))${RESET}"

  # State the successor must not redo or lose. The pull, the stash and the
  # stash's reapplication have ALL already happened in this process; the child
  # resumes at the build, so it must never re-fetch, re-rebase or re-stash.
  export OSA_UPDATE_REEXECED=1
  export OSA_UPDATE_PHASE="post-pull"
  export OSA_UPDATE_OLD_VER="${_ur_old_ver:-}"
  export OSA_UPDATE_HEAD_REV="${_ur_head_rev:-}"
  export OSA_UPDATE_NEW_VER="${_ur_new_ver:-}"
  export OSA_UPDATE_NEW_REV="${_ur_new_rev:-}"
  export OSA_UPDATE_RESTORED="${_ur_restored:-0}"
  export OSA_UPDATE_DIRTY="${_ur_dirty:-0}"
  export OSA_UPDATE_DISCARD="${_ur_discard:-0}"
  export OSA_UPDATE_STASH_NAME="${_ur_stash_name:-}"

  exec "$new" update ${1+"$@"}
  # Only reached if exec itself failed.
  echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Could not execute ${new}." >&2
  return 1
}

# Phase 2 of an in-place update: everything AFTER the tree has moved and local
# work has been reapplied. Factored out so the re-exec boundary has a defined
# place to resume into, and — more importantly — so the same-process run and
# the handed-off run execute literally the same code.
_update_after_pull() {
  local old_ver="$1" head_rev="$2" new_ver="$3" new_rev="$4"
  local restored="$5" dirty="$6" discard_local="$7" stash_name="$8"

  _update_build || return 1
  _update_verify_tui "$new_ver" || return 1
  # Disk is now new; make sure MEMORY is too before claiming anything.
  _update_restart_backend "$new_ver" || return 1

  # ── (a) Honest success report.
  echo ""
  if [ "$old_ver" = "$new_ver" ]; then
    echo -e "${GREEN}✓${RESET} ${BOLD}Updated${RESET} ${DIM}${head_rev} → ${new_rev}${RESET} ${DIM}(version unchanged: v${new_ver})${RESET}"
  else
    echo -e "${GREEN}✓${RESET} ${BOLD}Updated: v${old_ver} → v${new_ver}${RESET} ${DIM}(${head_rev} → ${new_rev})${RESET}"
  fi
  if [ "$restored" = "1" ]; then
    echo -e "${GREEN}✓${RESET} Your local changes were reintegrated cleanly."
  elif [ "$dirty" = "1" ] && [ "$discard_local" = "1" ]; then
    echo -e "${YELLOW}⚠${RESET} Local changes were set aside and NOT reapplied (--discard-local)."
    _update_print_stash_recovery "$stash_name"
  fi

  # Release notes for the version actually installed — never `[Unreleased]`.
  print_release_notes "$new_ver"
  _update_finish
  return 0
}

# ── "Up to date with your branch" is not "up to date with OSA" ──────────────
#
# Prints the caveat that belongs with the FINAL line of a source update, after
# the build, where it is actually read. Silent when the checkout is on the
# default branch (the two statements coincide) or when it is level with it.
#
# Args: <branch> <default_branch> <default_ref|""> <behind_default>
_update_stale_branch_notice() {
  _sbn_branch="$1"; _sbn_default="$2"; _sbn_ref="$3"; _sbn_behind="${4:-0}"

  [ "$_sbn_branch" = "$_sbn_default" ] && return 0

  if [ -z "$_sbn_ref" ]; then
    # We are off the default branch and could not resolve it, so we cannot say
    # whether this checkout is current with the project. Say that, rather than
    # letting the tick above stand as if we had checked.
    echo -e "  ${YELLOW}!${RESET} On branch ${BOLD}${_sbn_branch}${RESET}; ${BOLD}origin/${_sbn_default}${RESET} could not be resolved," >&2
    echo -e "    ${DIM}so this only means your branch has nothing new — not that you have the latest OSA.${RESET}" >&2
    echo -e "    ${DIM}Fetch it with: ${RESET}${CYAN}git -C '$ROOT' fetch origin ${_sbn_default}${RESET}" >&2
    return 0
  fi

  [ "${_sbn_behind}" -gt 0 ] 2>/dev/null || return 0

  echo -e "  ${YELLOW}!${RESET} ${BOLD}This is not the latest OSA.${RESET} Branch ${BOLD}${_sbn_branch}${RESET} is ${BOLD}${_sbn_behind}${RESET} commit(s) behind ${BOLD}${_sbn_ref}${RESET}."
  echo -e "    ${DIM}Your branch has nothing new to pull; the project does.${RESET}"
  echo -e "    ${DIM}Get the latest: ${RESET}${CYAN}git -C '$ROOT' checkout ${_sbn_default} && osa update${RESET}"
  echo -e "    ${DIM}Or without touching this tree: ${RESET}${CYAN}osa update --staged --ref ${_sbn_ref}${RESET}"
}

do_update_source() {
  # ── Resumption point for a re-exec'd update (see
  # _update_reexec_if_updater_changed). The pull, the stash and the reapply are
  # already done by our parent process; redoing any of them would at best
  # double-stash and at worst rebase a tree that is already rebased.
  if [ "${OSA_UPDATE_PHASE:-}" = "post-pull" ]; then
    echo -e "${GREEN}✓${RESET} Continuing under the updated ${BOLD}bin/osa${RESET} ${DIM}(the rest of this update runs the NEW logic)${RESET}"
    _update_after_pull \
      "${OSA_UPDATE_OLD_VER:-unknown}" "${OSA_UPDATE_HEAD_REV:-?}" \
      "${OSA_UPDATE_NEW_VER:-unknown}" "${OSA_UPDATE_NEW_REV:-?}" \
      "${OSA_UPDATE_RESTORED:-0}" "${OSA_UPDATE_DIRTY:-0}" \
      "${OSA_UPDATE_DISCARD:-0}" "${OSA_UPDATE_STASH_NAME:-}"
    return $?
  fi

  local discard_local=0 _a
  for _a in "$@"; do
    case "$_a" in
      --discard-local) discard_local=1 ;;
    esac
  done

  echo -e "${CYAN}→${RESET} Updating OSA ${DIM}(source checkout: $ROOT)${RESET}"

  local old_ver
  old_ver="$(cat "$ROOT/VERSION" 2>/dev/null || echo unknown)"

  # ── (c) Not a git checkout: we cannot check for updates AT ALL. Say exactly
  # that instead of rebuilding and calling it "up to date".
  if [ ! -d "$ROOT/.git" ] || ! command -v git >/dev/null 2>&1; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} ${ROOT} is not a git checkout (or git is unavailable)," >&2
    echo -e "  ${DIM}so there is no remote to compare against and nothing to pull.${RESET}" >&2
    echo -e "  ${DIM}Reinstall with: ${RESET}${CYAN}curl -fsSL https://raw.githubusercontent.com/Miosa-osa/OSA/main/scripts/install.sh | sh${RESET}" >&2
    return 1
  fi

  # ── Branch / upstream resolution. A detached HEAD or an untracked branch is
  # handled explicitly rather than assuming a fast-forward from main.
  local branch upstream default_branch
  branch="$(_ug symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} ${ROOT} has a detached HEAD ($(_ug rev-parse --short HEAD 2>/dev/null || echo '?'))." >&2
    echo -e "  ${DIM}Check out a branch first: ${RESET}${CYAN}git -C '$ROOT' checkout main${RESET}" >&2
    echo -e "  ${DIM}Or update without touching this tree at all: ${RESET}${CYAN}osa update --staged${RESET}" >&2
    return 1
  fi

  echo -e "${CYAN}→${RESET} Checking for updates ${DIM}(fetching origin)${RESET}..."
  if ! _ug fetch --quiet --tags origin; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Could not fetch from origin in ${ROOT}." >&2
    echo -e "  ${DIM}You may be offline, or the remote is unreachable. Until this succeeds OSA${RESET}" >&2
    echo -e "  ${DIM}cannot tell whether you are current, so it will not claim that you are.${RESET}" >&2
    echo -e "  ${DIM}Check with: ${RESET}${CYAN}git -C '$ROOT' fetch origin${RESET}" >&2
    return 1
  fi

  # `rev-parse --abbrev-ref @{u}` can echo the literal "@{u}" back on some git
  # versions when no upstream is configured, so the result is only trusted once
  # it actually resolves to a commit.
  upstream="$(_ug rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [ -n "$upstream" ] && ! _ug rev-parse --verify --quiet "${upstream}^{commit}" >/dev/null 2>&1; then
    upstream=""
  fi
  if [ -z "$upstream" ]; then
    if _ug rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
      upstream="origin/$branch"
    else
      echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Branch '${branch}' in ${ROOT} has no upstream on origin," >&2
      echo -e "  ${DIM}so there is nothing to update from. Either track a branch:${RESET}" >&2
      echo -e "    ${CYAN}git -C '$ROOT' branch --set-upstream-to=origin/main ${branch}${RESET}" >&2
      echo -e "  ${DIM}or update without touching this tree: ${RESET}${CYAN}osa update --staged${RESET}" >&2
      return 1
    fi
  fi

  default_branch="$(_ug symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  [ -n "$default_branch" ] || default_branch="main"
  if [ "$branch" != "$default_branch" ]; then
    echo -e "${YELLOW}⚠${RESET} On branch ${BOLD}${branch}${RESET} (not ${default_branch}) — updating against ${BOLD}${upstream}${RESET}."
  fi

  # ── Compare against the REMOTE, not the local VERSION file.
  local counts ahead behind head_rev target_rev
  counts="$(_ug rev-list --left-right --count "HEAD...$upstream" 2>/dev/null || true)"
  if [ -z "$counts" ]; then
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Could not compare HEAD with ${upstream} in ${ROOT}." >&2
    echo -e "  ${DIM}Inspect with: ${RESET}${CYAN}git -C '$ROOT' status${RESET}" >&2
    return 1
  fi
  ahead="${counts%%[	 ]*}"
  behind="${counts##*[	 ]}"
  head_rev="$(_ug rev-parse --short HEAD 2>/dev/null || echo '?')"
  target_rev="$(_ug rev-parse --short "$upstream" 2>/dev/null || echo '?')"

  # ── How far behind the PROJECT are we, as opposed to behind this branch?
  #
  # These are different questions and only one of them is what the comparison
  # above answers. A checkout parked on a feature branch whose upstream has no
  # new commits is "up to date with the branch" and can simultaneously be forty
  # commits behind main — which is exactly what happened: a user read the final
  # green tick, concluded nothing had been published, and was wrong. The
  # earlier "⚠ On branch X (not main)" line does not save it, because it is
  # printed BEFORE a build that takes a minute and is gone from attention by
  # the time the result lands.
  #
  # `rev-list --count` is one cheap plumbing call against refs we already
  # fetched, so establishing the fact costs nothing.
  local behind_default=0 default_ref=""
  if [ "$branch" != "$default_branch" ]; then
    if _ug rev-parse --verify --quiet "refs/remotes/origin/${default_branch}^{commit}" >/dev/null 2>&1; then
      default_ref="origin/${default_branch}"
      behind_default="$(_ug rev-list --count "HEAD..${default_ref}" 2>/dev/null || echo 0)"
      [ -n "$behind_default" ] || behind_default=0
    fi
  fi

  # ── Already current: no rebase, no stash, but still verify the build really
  # matches the tree (a stale binary self-heals here instead of lying forever).
  if [ "${behind:-0}" -eq 0 ]; then
    # The BUILD can still change what actually runs even when git has nothing to
    # pull — e.g. the tree is at 1.0.47 but the compiled artifacts are still
    # 1.0.46. Record the artifact version BEFORE building so the report can tell
    # "nothing happened" from "your binaries were stale and are now current".
    # Saying "Already up to date" after recompiling a new version is what made
    # the user believe, correctly for the wrong reason, that nothing shipped.
    local pre_tui
    pre_tui="$(_norm_version "$(_tui_binary_version || true)")"
    _update_build || return 1
    _update_verify_tui "$old_ver" || return 1
    _update_restart_backend "$old_ver" || return 1
    echo ""
    if [ -n "$pre_tui" ] && [ "$pre_tui" != "$(_norm_version "$old_ver")" ]; then
      echo -e "${GREEN}✓${RESET} ${BOLD}Updated to v${old_ver}${RESET} ${DIM}(rebuilt from stale v${pre_tui} artifacts; the checkout was already current)${RESET}"
      print_release_notes "$old_ver"
      _update_stale_branch_notice "$branch" "$default_branch" "$default_ref" "$behind_default"
    elif [ "${behind_default:-0}" -gt 0 ]; then
      # The branch has nothing new AND the project does. That is not a success,
      # so it does not get a success glyph.
      #
      # Every fact that changes the meaning is on this ONE line, because the
      # TUI's `/update` takes the first terminal outcome line as the result and
      # stops reading — a caveat on the following line would never reach it.
      echo -e "${YELLOW}⚠${RESET} ${BOLD}Not the latest OSA${RESET} — branch ${BOLD}${branch}${RESET} has no new commits but is ${BOLD}${behind_default}${RESET} commit(s) behind ${BOLD}${default_ref}${RESET} ${DIM}(v${old_ver}, HEAD ${head_rev})${RESET}"
      [ "${ahead:-0}" -gt 0 ] && \
        echo -e "  ${DIM}You have ${ahead} local commit(s) not on ${upstream}; they were left untouched.${RESET}"
      _update_stale_branch_notice "$branch" "$default_branch" "$default_ref" "$behind_default"
    elif [ "${ahead:-0}" -gt 0 ]; then
      echo -e "${GREEN}✓${RESET} Up to date with ${BOLD}${upstream}${RESET} ${DIM}(${target_rev})${RESET} — v${old_ver}"
      echo -e "  ${DIM}You have ${ahead} local commit(s) not on ${upstream}; they were left untouched.${RESET}"
      _update_stale_branch_notice "$branch" "$default_branch" "$default_ref" "$behind_default"
    else
      if [ -n "$default_ref" ]; then
        # On a feature branch that is level with the default branch: genuinely
        # current with the project, but say WHICH branch was checked so the
        # green tick is a claim the user can audit.
        echo -e "${GREEN}✓${RESET} Already up to date: ${BOLD}v${old_ver}${RESET} ${DIM}(HEAD ${head_rev} == ${upstream} ${target_rev}; level with ${default_ref})${RESET}"
      else
        echo -e "${GREEN}✓${RESET} Already up to date: ${BOLD}v${old_ver}${RESET} ${DIM}(HEAD ${head_rev} == ${upstream} ${target_rev})${RESET}"
        _update_stale_branch_notice "$branch" "$default_branch" "$default_ref" "$behind_default"
      fi
    fi
    _update_finish
    return 0
  fi

  echo -e "${CYAN}→${RESET} ${BOLD}${behind}${RESET} new commit(s) on ${BOLD}${upstream}${RESET} ${DIM}(${head_rev} → ${target_rev})${RESET}"
  [ "${ahead:-0}" -gt 0 ] && \
    echo -e "  ${DIM}You also have ${ahead} local commit(s); a rebase replays them on top (a reset would destroy them).${RESET}"

  # ── Local work: save it before touching anything.
  local dirty=0 stash_name stashed=0
  [ -n "$(_ug status --porcelain 2>/dev/null || true)" ] && dirty=1
  stash_name="osa-update-$(date +%Y%m%d-%H%M%S)"
  _osa_stash_commit=""

  if [ "$dirty" -eq 1 ] && [ "$discard_local" -eq 1 ]; then
    # Opt-out. Still a stash, never a delete: "discard" here means "do not
    # reapply", so the work remains recoverable by name.
    if [ ! -t 0 ]; then
      echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} --discard-local needs an interactive confirmation;" >&2
      echo -e "  ${DIM}refusing to set aside local work non-interactively.${RESET}" >&2
      return 1
    fi
    echo -e "${YELLOW}⚠${RESET} ${BOLD}--discard-local${RESET}: these local changes will NOT be reapplied after the update:"
    _ug status --short 2>/dev/null | head -20 | sed 's/^/    /'
    printf "  %bType 'discard' to continue (anything else aborts):%b " "$BOLD" "$RESET"
    local _reply=""
    read -r _reply || true
    if [ "$_reply" != "discard" ]; then
      echo -e "${YELLOW}⚠${RESET} ${BOLD}Not updated.${RESET} Aborted at your request; nothing was changed."
      return 1
    fi
  fi

  if [ "$dirty" -eq 1 ]; then
    echo -e "${CYAN}→${RESET} Saving local changes to stash ${BOLD}${YELLOW}${stash_name}${RESET} ${DIM}(including untracked files)${RESET}"
    if ! _ug stash push -u -m "$stash_name" >/dev/null; then
      echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Could not stash your local changes, so OSA refuses to" >&2
      echo -e "  ${DIM}update over them. Inspect with: ${RESET}${CYAN}git -C '$ROOT' status${RESET}" >&2
      return 1
    fi
    case "$(_ug stash list -1 --format='%gs' 2>/dev/null || true)" in
      *"$stash_name"*)
        stashed=1
        _osa_stash_commit="$(_ug rev-parse -q --verify refs/stash 2>/dev/null || true)"
        ;;
    esac
  fi

  # Snapshot the updater's own bytes BEFORE the tree moves, so that after the
  # rebase we can tell "the pull rewrote the script I am running" from "it
  # didn't". Taken after the stash push, so a stashed local edit to bin/osa is
  # already out of the way and cannot register as an incoming change.
  local pre_fp
  pre_fp="$(_update_script_fingerprint)"

  # ── Rebase (preserves local commits). On failure: abort, restore, report (c).
  echo -e "${CYAN}→${RESET} Rebasing onto ${BOLD}${upstream}${RESET}..."
  if ! _ug rebase "$upstream"; then
    _ug rebase --abort >/dev/null 2>&1 || true
    echo -e "${RED}✗${RESET} ${BOLD}Not updated.${RESET} Your local commits conflict with ${upstream}." >&2
    echo -e "  ${DIM}The rebase was aborted; ${ROOT} is exactly as you left it.${RESET}" >&2
    if [ "$stashed" -eq 1 ]; then
      if _ug stash apply >/dev/null 2>&1 && _update_stash_is_top; then
        _ug stash drop >/dev/null 2>&1 || true
        echo -e "  ${DIM}Your uncommitted changes were restored.${RESET}" >&2
      else
        _update_print_stash_recovery "$stash_name"
      fi
    fi
    echo -e "  ${DIM}Resolve manually with ${RESET}${CYAN}git -C '$ROOT' rebase $upstream${RESET}${DIM}, or update without${RESET}" >&2
    echo -e "  ${DIM}touching this tree at all: ${RESET}${CYAN}osa update --staged${RESET}" >&2
    return 1
  fi

  local new_ver new_rev
  new_ver="$(cat "$ROOT/VERSION" 2>/dev/null || echo "$old_ver")"
  new_rev="$(_ug rev-parse --short HEAD 2>/dev/null || echo '?')"

  # ── Restore local work. A conflicting apply NEVER drops the stash.
  local restored=0 apply_out=""
  if [ "$stashed" -eq 1 ] && [ "$discard_local" -eq 1 ]; then
    # Confirmed opt-out: the work stays in the named stash, deliberately not
    # reapplied. It is set aside, never deleted.
    :
  elif [ "$stashed" -eq 1 ]; then
    echo -e "${CYAN}→${RESET} Reapplying your local changes..."
    if apply_out="$(_ug stash apply 2>&1)"; then
      restored=1
      if _update_stash_is_top; then
        _ug stash drop >/dev/null 2>&1 || true
      fi
    else
      # (b) Updated, but the user's work needs manual resolution. The tree now
      # holds conflict markers and the stash is intact — both are recoverable,
      # and we refuse to build or launch on top of a conflicted tree.
      echo "" >&2
      echo -e "${YELLOW}⚠${RESET} ${BOLD}Updated to v${new_ver} (${new_rev}), but your local changes did not reapply cleanly.${RESET}" >&2
      printf '%s\n' "$apply_out" | sed 's/^/    /' >&2
      _update_print_stash_recovery "$stash_name"
      echo -e "  ${DIM}Resolve the conflicts in ${ROOT}, then run ${RESET}${CYAN}osa${RESET}${DIM} again.${RESET}" >&2
      echo -e "  ${DIM}To take the updated tree WITHOUT your changes (they stay in the stash above):${RESET}" >&2
      echo -e "    ${CYAN}git -C '$ROOT' checkout -- . && git -C '$ROOT' clean -fd${RESET}" >&2
      return 1
    fi
  fi

  # ── Hand off to the updater we just pulled, if the pull replaced it.
  #
  # Deliberately placed HERE — after the stash has been reapplied and dropped,
  # before anything is built. Re-exec'ing earlier would carry a live stash and
  # an unrestored working tree across a process boundary for no benefit; by
  # this line the user's work is already back in the tree and the only thing
  # left to do (build → verify → restart → report) is precisely the part whose
  # bugs the new script fixes. If the apply conflicted we returned above and
  # never get here, so a re-exec can never strand an unapplied stash.
  _ur_old_ver="$old_ver"; _ur_head_rev="$head_rev"
  _ur_new_ver="$new_ver"; _ur_new_rev="$new_rev"
  _ur_restored="$restored"; _ur_dirty="$dirty"
  _ur_discard="$discard_local"; _ur_stash_name="$stash_name"
  _update_reexec_if_updater_changed "$pre_fp" ${_osa_update_argv[@]+"${_osa_update_argv[@]}"} || return 1

  _update_after_pull "$old_ver" "$head_rev" "$new_ver" "$new_rev" \
    "$restored" "$dirty" "$discard_local" "$stash_name"
  return $?
}

# Shared tail of every successful do_update_source path.
_update_finish() {
  echo ""
  echo -e "  ${DIM}Local edits in this checkout are preserved across ${RESET}${CYAN}osa update${RESET}${DIM}: they are stashed,${RESET}"
  echo -e "  ${DIM}the tree is rebased onto the latest, then they are reapplied. Use ${RESET}${CYAN}--discard-local${RESET}${DIM} for a pristine tree.${RESET}"
  echo -e "  ${DIM}Tip: ${RESET}${CYAN}osa update --staged${RESET}${DIM} stages, builds, and health-checks before switching, with automatic rollback if anything looks wrong.${RESET}"

  # NOTE: the daemon restart happens in _update_restart_backend, BEFORE the
  # success message is printed. It used to be a silent best-effort
  # `stop_daemon >/dev/null 2>&1 || true` here, which is how a surviving old
  # daemon got reported as a successful update.

  echo ""
  if [ -t 0 ]; then
    printf "  %bPress Enter to launch OSA...%b " "$DIM" "$RESET" >&2
    read -r _ || true
  fi
}

# ── Update (rollback-safe): stage -> health-check -> atomic symlink swap ──
# Delegates to bin/osa-update, which does the actual git-worktree staging,
# build, boot-probe and atomic `$OSA_HOME/current` swap (see that script's
# header for the full design + why it's safe to test in isolation). This
# function only handles the CLI/UX wrapper: locating the helper, forwarding
# flags, and — on success — falling through to the normal launch path so
# `osa update --staged` still ends with "then launch" like plain `osa update`.
#
# UPDATER: bin/osa-update lives next to this script for a direct/dev checkout,
# but once $OSA_HOME/current exists this script itself may be running FROM
# inside a staged version dir — always resolve the helper relative to the
# currently-resolved $ROOT (which points at the exact same checkout this
# launcher is running from) rather than SCRIPT_DIR, so an old cached helper
# in a stale versions/<rev> dir is never used by mistake.
do_update_staged() {
  local updater="$ROOT/bin/osa-update"
  [ -x "$updater" ] || updater="$SCRIPT_DIR/osa-update"
  if [ ! -x "$updater" ]; then
    echo -e "${RED}✗${RESET} bin/osa-update not found, cannot do a staged update." >&2
    return 1
  fi

  if [ "${1:-}" = "--rollback" ]; then
    shift
    "$updater" rollback --home "$OSA_HOME" "$@"
    return $?
  fi

  "$updater" update --root "$ROOT" --home "$OSA_HOME" "$@"
}

# Print the CHANGELOG section for the version we actually installed ($1).
#
# The old version printed the FIRST `## [` block in the file, which on any
# working checkout is `## [Unreleased]` — unreleased notes shown as if they were
# the release the user just got, and shown even when no update happened at all.
# Now the version is required and matched exactly, so `[Unreleased]` can never
# be selected; if there is no section for that version we print nothing.
print_release_notes() {
  local ver="${1:-}" changelog body
  [ -n "$ver" ] || return 0
  # The ROOT changelog is where releases are recorded; priv/CHANGELOG.md stops
  # at 0.9.0 and has no 1.0.x sections at all, so preferring it printed an
  # empty "What's new" block on every source-checkout update.
  changelog="$ROOT/CHANGELOG.md"
  [ -f "$changelog" ] || changelog="$ROOT/priv/CHANGELOG.md"
  [ -f "$changelog" ] || changelog="$ROOT/docs/operations/changelog.md"
  [ -f "$changelog" ] || return 0

  body="$(awk -v ver="$ver" '
    BEGIN { want = "## [" ver "]" }
    index($0, want) == 1 { inblk = 1; print; next }
    inblk && /^## \[/ { exit }
    inblk && shown < 24 { print; shown++ }
  ' "$changelog" 2>/dev/null || true)"
  [ -n "$body" ] || return 0

  echo ""
  echo -e "  ${BOLD}What's new in v${ver}${RESET}"
  printf '%s\n' "$body" | sed 's/^/    /'
}

# ── Version display padding ───────────────────────────────────────
# Pad the patch component to a minimum of 3 digits for DISPLAY only
# (1.0.1 -> 1.0.001, 1.0.17 -> 1.0.017, 1.0.128 -> 1.0.128). Major/minor and
# any -pre/+build suffix pass through untouched; a version that isn't a 3-part
# numeric core is returned unchanged. Mirrors the TUI's osa_version_display()
# so every surface reads the same padded form. Pure awk/printf — no network or
# destructive tooling involved.
# Normalize a version for COMPARISON (the inverse of pad_version): drop a
# leading "v", drop any pre-release/build suffix, and strip the display
# zero-padding, so the VERSION file (1.0.47) and the TUI's padded `--version`
# output (1.0.047) compare equal. Mirrors _norm_version in scripts/install.sh.
_norm_version() {
  printf '%s' "${1#v}" | awk -F'[-+]' '{print $1}' \
    | awk -F. '{ if (NF == 3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/)
                   printf "%d.%d.%d", $1, $2, $3
                 else printf "%s", $0 }'
}

pad_version() {
  printf '%s' "${1:-}" | awk '
    {
      v = $0; core = v; suffix = ""
      if (match(v, /[-+]/)) { core = substr(v, 1, RSTART - 1); suffix = substr(v, RSTART) }
      n = split(core, p, ".")
      if (n == 3 && p[1] ~ /^[0-9]+$/ && p[2] ~ /^[0-9]+$/ && p[3] ~ /^[0-9]+$/)
        printf "%s.%s.%03d%s\n", p[1], p[2], p[3] + 0, suffix
      else
        print v
    }'
}

# ── Launch-verb pre-translation (verbs → TUI flags, then launch) ───
#
# `overdrive` / `continue` / `resume` are launch verbs: they are rewritten to
# the equivalent TUI flag so the TUI keeps ONE argument parser.
#
# The verb is found WHEREVER it sits in argv, not only at $1, so mode flags may
# come before it as well as after:
#
#   osa resume <id> --overdrive
#   osa --overdrive resume <id>      ← this ordering specifically
#
# A flag's VALUE is never a verb: `osa --model resume` selects a model named
# "resume". Only these three verbs are scanned position-independently; every
# other subcommand (version/setup/serve/doctor/stop/update/opencomputers/
# remote/help) keeps its existing `$1`-only dispatch below, untouched.
OVERDRIVE=0
_verb=""
_skip=0
for _a in "$@"; do
  if [ "$_skip" -eq 1 ]; then _skip=0; continue; fi
  case "$_a" in
    --) break ;;
    --profile|--permission-mode|--model|-m|--provider) _skip=1 ;;
    -*) ;;
    overdrive|continue|resume) _verb="$_a"; break ;;
    *) break ;;
  esac
done

if [ -n "$_verb" ]; then
  # Strip the verb (and, for `resume`, the id immediately after it) out of argv,
  # then append the equivalent flag. Rotating $@ keeps every other flag in place.
  _n=$#; _i=0; _skip=0; _hit=0; _next=0; _rid=""
  while [ "$_i" -lt "$_n" ]; do
    _a="$1"; shift; _i=$((_i + 1))
    if [ "$_skip" -eq 1 ]; then _skip=0; set -- "$@" "$_a"; continue; fi
    case "$_a" in
      --profile|--permission-mode|--model|-m|--provider)
        _skip=1; set -- "$@" "$_a"; continue ;;
    esac
    if [ "$_hit" -eq 0 ] && [ "$_a" = "$_verb" ]; then
      _hit=1; _next=1; continue
    fi
    if [ "$_next" -eq 1 ]; then
      _next=0
      if [ "$_verb" = "resume" ] && [ "${_a#-}" = "$_a" ]; then
        _rid="$_a"; continue
      fi
    fi
    set -- "$@" "$_a"
  done
  case "$_verb" in
    overdrive) OVERDRIVE=1; set -- "$@" "--overdrive" ;;
    continue)  set -- "$@" "--continue" ;;
    resume)
      # Bare `osa resume` → the session picker, populated from recent sessions.
      if [ -n "$_rid" ]; then
        set -- "$@" "--resume" "$_rid"
      else
        set -- "$@" "--resume"
      fi
      ;;
  esac
fi

# Any explicit full-auto flag also trips the warning.
for _a in "$@"; do
  case "$_a" in
    --overdrive|--dangerously-skip-permissions|--yolo) OVERDRIVE=1 ;;
  esac
done

# ── Subcommand dispatch ───────────────────────────────────────────
case "${1:-}" in
  version|--version|-v)
    # Display uses the padded patch (1.0.1 -> 1.0.001); the VERSION file itself
    # stays valid semver for mix/cargo.
    if [ -f "$ROOT/VERSION" ]; then
      echo "osagent v$(pad_version "$(cat "$ROOT/VERSION")")"
    else
      _v="$(cd "$ROOT" && mix run -e "IO.puts(Application.spec(:optimal_system_agent, :vsn))" 2>/dev/null)"
      if [ -n "$_v" ]; then
        echo "osagent v$(pad_version "$_v")"
      else
        echo "osagent (version unknown)"
      fi
    fi
    exit 0
    ;;

  setup)
    echo -e "${CYAN}→${RESET} Running setup wizard..."
    (cd "$ROOT" && mix osa.setup.wizard)
    exit $?
    ;;

  stop)
    _stop_backend_confirmed
    exit $?
    ;;

  update)
    shift || true
    # `--rollback` / `--dry-run` only make sense against the new rollback-safe
    # staged flow, so either one implies `--staged`. Plain `osa update` keeps
    # today's simple in-place git-pull-and-rebuild — no behavior change.
    _update_staged=0
    _update_args=()
    for _a in "$@"; do
      case "$_a" in
        --staged) _update_staged=1 ;;
        --rollback|--dry-run) _update_staged=1; _update_args+=("$_a") ;;
        --ref) _update_staged=1; _update_args+=("$_a") ;;
        *) _update_args+=("$_a") ;;
      esac
    done
    if [ "$_update_staged" = 1 ]; then
      if do_update_staged "${_update_args[@]}"; then
        # A successful --dry-run or --rollback already printed everything it
        # needs to; a real staged update prints its own success line. Either
        # way, fall through to the normal launch below — except --dry-run,
        # which by definition changed nothing worth relaunching for.
        case " ${_update_args[*]} " in
          *" --dry-run "*) exit 0 ;;
        esac
      else
        echo -e "${RED}✗${RESET} Staged update failed. Current install left untouched." >&2
        exit 1
      fi
    else
      # Recorded verbatim so that if the pull replaces bin/osa mid-update we can
      # replay the user's exact invocation into the new script (see
      # _update_reexec_if_updater_changed). `--settings` is not here because it
      # is consumed above into the exported OSA_SETTINGS, which survives exec.
      _osa_update_argv=(${_update_args[@]+"${_update_args[@]}"})
      # Propagate the exit code: a failed in-place update must NOT fall through
      # to the launch path as if it had succeeded.
      do_update_source ${_update_args[@]+"${_update_args[@]}"} || exit $?
    fi
    # fall through to the default launch
    ;;

  serve)
    echo -e "${CYAN}→${RESET} Starting backend (foreground)..."
    (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
    (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
    (cd "$ROOT" && mix deps.get --quiet 2>&1 | tail -3)
    (cd "$ROOT" && mix osa.serve)
    exit 0
    ;;

  doctor)
    shift
    # Forward flags (currently --config / --all) as an Elixir list of strings.
    DOCTOR_ARGS=$(printf '"%s",' "$@")
    DOCTOR_ARGS="[${DOCTOR_ARGS%,}]"
    (cd "$ROOT" && mix run --no-start -e "OptimalSystemAgent.CLI.Doctor.run(${DOCTOR_ARGS})" 2>/dev/null) || \
      echo "Doctor command not available. Try: osa then type /doctor"
    exit 0
    ;;

  # `osa auth` / `osa logout` — the supported way OUT of an account sign-in.
  # `--no-start` because every one of these is a local file operation or a
  # sign-in flow; none of them needs the daemon, and booting the full OTP tree
  # to print a status table would make `osa auth status` slower than the thing
  # it reports on. The exit code is propagated so a scripted
  # `osa auth logout <provider>` that did nothing cannot look like a success.
  auth)
    shift
    (cd "$ROOT" && mix run --no-start -e "
      case OptimalSystemAgent.CLI.Auth.run(System.argv()) do
        :ok -> :ok
        _ -> System.halt(1)
      end" -- "$@" 2>/dev/null) || _rc=$?
    # stderr is dropped for the same reason `doctor` above drops it: on a
    # source checkout the first invocation after an edit recompiles, and a
    # hundred lines of dependency warnings on top of a four-line status table
    # makes the answer unreadable. A build FAILURE still surfaces — the Elixir
    # side never runs, so the exit code is >1 and is reported here rather than
    # swallowed.
    if [ "${_rc:-0}" -gt 1 ]; then
      echo "osa auth is unavailable — the backend failed to build. Run: osa doctor" >&2
    fi
    exit ${_rc:-0}
    ;;

  # `osa usage` — account quota + OSA's own token count. `--no-start` for the
  # same reason as `osa auth`: every source it reads is a local file or a free
  # loopback call, so booting the OTP tree would make the status screen slower
  # than the thing it reports on.
  usage)
    shift
    (cd "$ROOT" && mix run --no-start -e "
      case OptimalSystemAgent.CLI.Usage.run(System.argv()) do
        :ok -> :ok
        {:error, msg} -> IO.puts(:stderr, to_string(msg)); System.halt(1)
      end" -- "$@")
    exit $?
    ;;

  logout)
    shift
    (cd "$ROOT" && mix run --no-start -e "
      case OptimalSystemAgent.CLI.Auth.run([\"logout\" | System.argv()]) do
        :ok -> :ok
        _ -> System.halt(1)
      end" -- "$@" 2>/dev/null) || _rc=$?
    # stderr is dropped for the same reason `doctor` above drops it: on a
    # source checkout the first invocation after an edit recompiles, and a
    # hundred lines of dependency warnings on top of a four-line status table
    # makes the answer unreadable. A build FAILURE still surfaces — the Elixir
    # side never runs, so the exit code is >1 and is reported here rather than
    # swallowed.
    if [ "${_rc:-0}" -gt 1 ]; then
      echo "osa logout is unavailable — the backend failed to build. Run: osa doctor" >&2
    fi
    exit ${_rc:-0}
    ;;

  opencomputers)
    shift
    (cd "$ROOT" && mix run --no-start -e "OptimalSystemAgent.CLI.opencomputers(System.argv())" -- "$@")
    exit $?
    ;;

  remote)
    shift
    (cd "$ROOT" && mix run --no-start -e "OptimalSystemAgent.CLI.remote(System.argv())" -- "$@")
    exit $?
    ;;

  help|--help|-h)
    print_help
    exit 0
    ;;
esac

# ── Default: warm the daemon, then launch the TUI ────────────────

detect_pkg

# ── Auto-install missing dependencies (first run on a source checkout) ──

# Install native build deps for Rust TUI on Linux
install_linux_build_deps() {
  [ "$(uname -s)" = "Linux" ] || return 0
  [ -f "$TUI_BIN" ] && return 0

  echo -e "${CYAN}→${RESET} Checking build dependencies..."
  case "$PKG" in
    apt)
      local needed=()
      command -v pkg-config >/dev/null 2>&1 || needed+=(pkg-config)
      command -v gcc >/dev/null 2>&1        || needed+=(build-essential)
      [ -f /usr/lib/*/libssl.so ] 2>/dev/null || [ -f /usr/lib/*/libssl.a ] 2>/dev/null || needed+=(libssl-dev)
      [ -f /usr/lib/*/libxcb.so ] 2>/dev/null || [ -f /usr/lib/*/libxcb.a ] 2>/dev/null || needed+=(libxcb1-dev libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev)
      [ -f /usr/lib/*/libasound.so ] 2>/dev/null || [ -f /usr/lib/*/libasound.a ] 2>/dev/null || needed+=(libasound2-dev)
      [ -f /usr/lib/*/libonig.so ] 2>/dev/null || [ -f /usr/lib/*/libonig.a ] 2>/dev/null || needed+=(libonig-dev)
      if [ ${#needed[@]} -gt 0 ]; then
        echo -e "${CYAN}→${RESET} Installing: ${needed[*]}..."
        $SUDO apt-get update -qq 2>/dev/null || true
        $SUDO apt-get install -y -qq "${needed[@]}" 2>/dev/null || true
      fi
      ;;
    dnf|yum)
      pkg_install gcc gcc-c++ make pkg-config openssl-devel libxcb-devel alsa-lib-devel oniguruma-devel 2>/dev/null || true
      ;;
    pacman)
      pkg_install base-devel pkg-config openssl libxcb alsa-lib oniguruma 2>/dev/null || true
      ;;
    apk)
      pkg_install build-base pkgconfig openssl-dev libxcb-dev alsa-lib-dev oniguruma-dev 2>/dev/null || true
      ;;
    zypper)
      pkg_install gcc gcc-c++ make pkg-config libopenssl-devel libxcb-devel alsa-devel oniguruma-devel 2>/dev/null || true
      ;;
  esac
}

# Auto-install Rust if missing
if ! command -v cargo >/dev/null 2>&1; then
  echo -e "${CYAN}→${RESET} Rust not found — installing automatically..."
  if command -v curl >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --quiet
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://sh.rustup.rs | sh -s -- -y --quiet
  else
    echo -e "${RED}✗ Neither curl nor wget found.${RESET}"
    echo -e "${DIM}  Falling back to CLI mode.${RESET}"
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
  . "${HOME}/.cargo/env" 2>/dev/null || true
  export PATH="${HOME}/.cargo/bin:$PATH"
  if ! command -v cargo >/dev/null 2>&1; then
    echo -e "${RED}✗ Rust installation failed.${RESET} Install manually: https://rustup.rs"
    echo -e "${DIM}  Falling back to CLI mode.${RESET}"
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
  echo -e "${GREEN}✓${RESET} Rust installed"
fi

# Auto-install Elixir if missing or too old
install_elixir_prebuilt() {
  local elixir_ver="1.18.3"
  local otp_major
  otp_major=$(erl -eval 'io:format("~s", [erlang:system_info(otp_release)]), halt().' -noshell 2>/dev/null || echo "27")
  local url="https://github.com/elixir-lang/elixir/releases/download/v${elixir_ver}/elixir-otp-${otp_major}.zip"
  echo -e "${CYAN}→${RESET} Installing Elixir ${elixir_ver} from prebuilt..."
  local dest="/usr/local/lib/elixir"
  $SUDO mkdir -p "$dest"
  command -v unzip >/dev/null 2>&1 || pkg_install unzip 2>/dev/null || true
  if curl -fsSLo /tmp/elixir.zip "$url" 2>/dev/null; then
    $SUDO unzip -qo /tmp/elixir.zip -d "$dest"
    rm -f /tmp/elixir.zip
    for bin in elixir mix iex elixirc; do
      $SUDO ln -sf "$dest/bin/$bin" /usr/local/bin/"$bin"
    done
    echo -e "${GREEN}✓${RESET} Elixir ${elixir_ver} installed"
  else
    echo -e "${RED}✗ Could not download Elixir prebuilt.${RESET}"
    return 1
  fi
}

if ! command -v mix >/dev/null 2>&1; then
  echo -e "${CYAN}→${RESET} Elixir not found — installing automatically..."
  case "$(uname -s)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        echo -e "${CYAN}→${RESET} Installing Homebrew first..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ -f "/opt/homebrew/bin/brew" ]; then
          eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -f "/usr/local/bin/brew" ]; then
          eval "$(/usr/local/bin/brew shellenv)"
        fi
      fi
      brew install erlang elixir
      ;;
    Linux)
      case "$PKG" in
        apt) $SUDO apt-get update -qq; pkg_install erlang 2>/dev/null || true ;;
        dnf|yum) pkg_install epel-release 2>/dev/null || true; pkg_install erlang 2>/dev/null || true ;;
        pacman) pkg_install erlang 2>/dev/null || true ;;
        apk) pkg_install erlang 2>/dev/null || true ;;
        zypper) pkg_install erlang 2>/dev/null || true ;;
      esac
      pkg_install elixir 2>/dev/null || true
      if ! command -v mix >/dev/null 2>&1 || ! check_elixir_version; then
        install_elixir_prebuilt || {
          echo -e "${RED}✗ Cannot install Elixir.${RESET}"
          exit 1
        }
      fi
      ;;
  esac
  if ! command -v mix >/dev/null 2>&1; then
    echo -e "${RED}✗ Elixir installation failed.${RESET}"
    exit 1
  fi
  echo -e "${GREEN}✓${RESET} Elixir ready"
  echo -e "${CYAN}→${RESET} Fetching dependencies..."
  (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix deps.get 2>&1 | tail -5)
  (cd "$ROOT" && mix compile 2>&1 | tail -5)
elif ! check_elixir_version; then
  echo -e "${YELLOW}⚠${RESET} Elixir version too old (need 1.17+). Upgrading..."
  install_elixir_prebuilt || echo -e "${RED}✗ Could not upgrade Elixir.${RESET}"
fi

# Install Linux build deps before Rust build
install_linux_build_deps

# Build Rust TUI if needed
if [ ! -f "$TUI_BIN" ]; then
  if [ -f "$TUI_DIR/Cargo.toml" ]; then
    echo -e "${CYAN}→${RESET} Building TUI (first run, ~60s)..."
    (cd "$TUI_DIR" && cargo build --release 2>&1 | tail -10)
    if [ ! -f "$TUI_BIN" ]; then
      echo -e "${RED}✗ TUI build failed.${RESET} Falling back to CLI mode."
      echo -e "${DIM}  Check: cargo, rustc installed? Run: rustup update${RESET}"
      (cd "$ROOT" && mix osa.chat)
      exit $?
    fi
  else
    echo -e "${RED}✗ TUI source not found.${RESET} Falling back to CLI mode."
    (cd "$ROOT" && mix osa.chat)
    exit $?
  fi
fi

# Ensure Elixir deps are compiled
if [ ! -d "$ROOT/_build" ]; then
  echo -e "${CYAN}→${RESET} First-time compile..."
  (cd "$ROOT" && mix local.hex --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix local.rebar --force --if-missing >/dev/null 2>&1 || true)
  (cd "$ROOT" && mix deps.get 2>&1 | tail -5)
  (cd "$ROOT" && mix compile 2>&1 | tail -5)
fi

# Auto-enable computer_use on Linux X11
if [ "$(uname -s)" = "Linux" ] && [ -n "${DISPLAY:-}" ]; then
  export OSA_COMPUTER_USE="${OSA_COMPUTER_USE:-true}"
fi

# Build the TUI arg list (strip --dev, which is a launcher-only concern).
TUI_ARGS=()
for arg in "$@"; do
  [ "$arg" = "--dev" ] && continue
  TUI_ARGS+=("$arg")
done

# ── Warm the backend daemon (attach instantly if already healthy) ──
#
# Skew repair comes FIRST, before the attach decision: _ensure_fresh_daemon
# stops a backend that is serving an older build than this checkout, which
# turns the fast attach path below into the slow start-fresh path for exactly
# the launches that need it. The user is never told to run `osa stop`.
if backend_healthy && ! _ensure_fresh_daemon; then
  exit 1
fi

if backend_healthy; then
  echo -e "${DIM}Backend already running on :${PORT} — attaching.${RESET}"
else
  clear_stale_pid
  start_daemon
  rc=0
  wait_health 90 || rc=$?
  if [ "${rc:-0}" -eq 2 ]; then
    echo -e "${RED}✗ Backend exited during startup.${RESET}"
    if command -v lsof >/dev/null 2>&1 && lsof -i ":${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
      echo -e "  ${DIM}Port ${PORT} is already in use. Try:${RESET} ${CYAN}OSA_PORT=<n> osa${RESET} ${DIM}or${RESET} ${CYAN}osa stop${RESET}"
    fi
    echo "  Last log lines:"
    tail -15 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
    rm -f "$PID_FILE" "$PORT_FILE" 2>/dev/null || true
    exit 1
  elif [ "${rc:-0}" -eq 1 ]; then
    echo -e "${RED}✗ Backend did not become healthy on :${PORT} in time.${RESET}"
    echo "  Last log lines:"
    tail -15 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
    exit 1
  fi
  echo -e "${DIM}Backend ready. It stays warm in the background — ${RESET}${CYAN}osa stop${RESET}${DIM} to shut it down.${RESET}"
fi

# First-run: if ~/.osa/.env has no configured provider yet, run the setup
# wizard. Gated on env_has_provider (see its definition above, m9 fix) —
# NOT plain file existence — so this always agrees with the app's own
# Onboarding.first_run?/0 check.
#
# The wizard runs as its OWN OS process (not the daemon warmed above), so its
# System.put_env/Application.put_env calls (onboarding.ex apply_env_vars) only
# mutate that subprocess and are lost the instant it exits. The already-warm
# daemon never sees the key it just wrote to ~/.osa/.env and keeps serving
# from its stale boot-time config (default_provider=:ollama, every
# *_api_key=nil) — the first turn then fails despite a valid key just having
# been entered. Restart the daemon here so config/runtime.exs re-reads the
# freshly written .env before the TUI ever attaches.
if ! env_has_provider "$OSA_HOME/.env"; then
  echo -e "${CYAN}→${RESET} First-time setup..."
  if (cd "$ROOT" && mix osa.setup.wizard); then
    if env_has_provider "$OSA_HOME/.env"; then
      echo -e "${CYAN}→${RESET} Restarting backend to load your new configuration…"
      _stop_backend_confirmed
      clear_stale_pid
      start_daemon
      rc=0
      wait_health 90 || rc=$?
      if [ "${rc:-0}" -ne 0 ]; then
        echo -e "${RED}✗ Backend did not come back up after setup.${RESET}"
        echo "  Last log lines:"
        tail -15 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
        echo -e "  ${DIM}Try:${RESET} ${CYAN}osa stop && osa${RESET}"
        exit 1
      fi
    fi
  else
    echo -e "${YELLOW}⚠${RESET} Setup skipped. Run 'osa setup' later to configure."
  fi
fi

# Show the overdrive warning right before handing off to the TUI.
[ "$OVERDRIVE" -eq 1 ] && warn_overdrive

# Launch the TUI. The backend daemon deliberately outlives this process.
export OSA_URL="http://localhost:${PORT}"
exec "$TUI_BIN" ${TUI_ARGS[@]+"${TUI_ARGS[@]}"}

  echo -e "    ${CYAN}osa resume${RESET} ${DIM}[id]${RESET}      Resume a specific session ${DIM}(or pick one)${RESET}"
  echo -e "    ${CYAN}osa stop${RESET}             Stop the background backend daemon"
  echo -e "    ${CYAN}osa setup${RESET}            Run the setup wizard ${DIM}(provider / API keys)${RESET}"
